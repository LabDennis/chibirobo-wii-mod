+            is_book = br_rel == "how_to_chibirobo/cb_book.brres"
+            new_br, br_stats = replace_brres_textures(
+                wii_br_path.read_bytes(),
+                jp_dat_path.read_bytes(),
+                tgt_dat_path.read_bytes(),
