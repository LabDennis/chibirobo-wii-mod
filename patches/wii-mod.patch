+            transferred_files.append(rel_path)
+
+        tgt_dat_dir = extracted["us_dat"] if disc_key == "us" else extracted["pal_dat"]
+        jp_dat_dir = extracted.get("jp_dat")
+        brres_details: Dict[str, object] = {}
+        for br_rel, dat_rel in BRRES_DAT_PAIRS:
+            wii_br_path = extracted["wii_brres"] / br_rel
+            tgt_dat_path = tgt_dat_dir / dat_rel
+            jp_dat_path = (jp_dat_dir / dat_rel) if jp_dat_dir is not None else None
+            if jp_dat_path is None or not jp_dat_path.exists():
