+def _fit_rgba_aspect(rgba: bytes, src_w: int, src_h: int, dst_w: int, dst_h: int) -> bytes:
+    """Scale RGBA image to fit inside (dst_w, dst_h) without cropping, centered on transparent canvas."""
+    if src_w == dst_w and src_h == dst_h:
+        return rgba
+    scale = min(dst_w / src_w, dst_h / src_h)
+    new_w = max(1, min(dst_w, round(src_w * scale)))
+    new_h = max(1, min(dst_h, round(src_h * scale)))
+    src_img = Image.frombytes("RGBA", (src_w, src_h), rgba)
+    resized = src_img.resize((new_w, new_h), Image.Resampling.LANCZOS)
+    canvas = Image.new("RGBA", (dst_w, dst_h), (0, 0, 0, 0))
+    canvas.paste(resized, ((dst_w - new_w) // 2, (dst_h - new_h) // 2))
+    return canvas.tobytes()
+
+
+def _render_misc_preview(
+    preview_path: Path,
+    rows: Sequence[Tuple[int, int, int, str, Tuple[int, int, bytes], Tuple[int, int, bytes], Tuple[int, int, bytes]]],
+) -> None:
+    """Save side-by-side overview PNG (Wii, GC-JP, Result) for replaced/skipped textures."""
+    if not rows:
+        return
+    max_w = max(max(row[4][0], row[5][0], row[6][0]) for row in rows)
+    max_h = max(max(row[4][1], row[5][1], row[6][1]) for row in rows)
+    col_w = max(220, max_w + 16)
+    row_h = max(84, max_h + 16)
+    canvas = Image.new("RGBA", (max(920, 240 + col_w * 3), len(rows) * row_h), (36, 36, 36, 255))
+    draw = ImageDraw.Draw(canvas)
+    for idx, (wi, ji, ti, label, w_im, j_im, r_im) in enumerate(rows):
+        y = idx * row_h + 6
+        draw.text((8, y + 6), f"wii[{wi}] jp[{ji}] us[{ti}]\n{label}", fill=(240, 240, 240, 255))
+        for col_i, (rw, rh, rbytes) in enumerate((w_im, j_im, r_im)):
+            im = Image.frombytes("RGBA", (rw, rh), rbytes)
+            scale = max(1, min(2, 64 // max(1, rh)))
+            if scale > 1:
+                im = im.resize((rw * scale, rh * scale), Image.Resampling.NEAREST)
+            canvas.paste(im, (240 + col_i * col_w, y), im)
+    preview_path.parent.mkdir(parents=True, exist_ok=True)
+    canvas.save(preview_path)
+
+
+def convert_tpl_textures_by_jp(
+    wii_tpl: bytes,
+    jp_tpl: bytes,
+    target_tpl: bytes,
+    max_mad: float = 15.0,
+    min_margin: float = 2.0,
+    text_wii_indices: Optional[Dict[int, Tuple[bool, str]]] = None,
+    preview_path: Optional[Path] = None,
+    explicit_target_map: Optional[Dict[int, int]] = None,
+    allow_aspect_fit: bool = False,
+) -> Tuple[bytes, Dict[str, object]]:
+    """Map Wii TPL textures to target TPL via GC-JP reference and replace differing text ones."""
+    w_texs = parse_tpl_textures(wii_tpl)
+    j_texs = parse_tpl_textures(jp_tpl)
+    t_texs = parse_tpl_textures(target_tpl)
+
+    w_dec = _decode_tpl_list(w_texs)
+    j_dec = _decode_tpl_list(j_texs)
+    t_dec = _decode_tpl_list(t_texs)
+
+    # Map JP -> target using RGBA-hash anchors and (w, h) counts in gaps
+    j_keys = [x[4] for x in j_dec]
+    t_keys = [x[4] for x in t_dec]
+    sm_jt = difflib.SequenceMatcher(None, j_keys, t_keys, autojunk=False)
+    jp_to_tgt: Dict[int, int] = {}
+    for tag, i1, i2, j1, j2 in sm_jt.get_opcodes():
+        if tag == "equal":
+            for k in range(i2 - i1):
+                jp_to_tgt[i1 + k] = j1 + k
+        elif tag == "replace":
+            by_dim_j: Dict[Tuple[int, int], List[int]] = {}
+            by_dim_t: Dict[Tuple[int, int], List[int]] = {}
+            for ji in range(i1, i2):
+                by_dim_j.setdefault((j_dec[ji][0], j_dec[ji][1]), []).append(ji)
+            for ti in range(j1, j2):
+                by_dim_t.setdefault((t_dec[ti][0], t_dec[ti][1]), []).append(ti)
+            for dim, jl in by_dim_j.items():
+                tl = by_dim_t.get(dim, [])
+                if len(jl) == len(tl):
+                    for ji, ti in zip(jl, tl):
+                        jp_to_tgt[ji] = ti
+            if i2 - i1 == 1 and j2 - j1 == 1 and i1 not in jp_to_tgt:
+                jp_to_tgt[i1] = j1
+
+    # Map Wii -> JP: exact hash anchors first, then global non-greedy MAD with second-best margin
+    w_keys = [x[4] for x in w_dec]
+    sm_wj = difflib.SequenceMatcher(None, w_keys, j_keys, autojunk=False)
+    wii_to_jp: Dict[int, int] = {}
+    used_jp = set()
+    for tag, i1, i2, j1, j2 in sm_wj.get_opcodes():
+        if tag == "equal":
+            for k in range(i2 - i1):
+                wii_to_jp[i1 + k] = j1 + k
+                used_jp.add(j1 + k)
+
+    unmapped_w = [wi for wi in range(len(w_dec)) if wi not in wii_to_jp]
+    unmapped_j = [ji for ji in range(len(j_dec)) if ji not in used_jp]
+    all_pairs: List[Tuple[float, int, int]] = []
+    w_cands: Dict[int, List[Tuple[float, int]]] = {}
+    for wi in unmapped_w:
+        ww, wh, _, wrgba, w_md5 = w_dec[wi]
+        cands: List[Tuple[float, int]] = []
+        for ji in unmapped_j:
+            jw, jh, _, jrgba, j_md5 = j_dec[ji]
+            if ww != jw or wh != jh:
+                continue
+            mad = 0.0 if w_md5 == j_md5 else _mean_abs_rgba_diff(wrgba, jrgba)
+            cands.append((mad, ji))
+            if mad <= max_mad:
+                all_pairs.append((mad, wi, ji))
+        cands.sort()
+        w_cands[wi] = cands
+
+    ambiguous_wii: Dict[int, Dict[str, object]] = {}
+    for wi, cands in w_cands.items():
+        if len(cands) >= 2 and cands[0][0] <= max_mad and (cands[1][0] - cands[0][0]) < min_margin:
+            ambiguous_wii[wi] = {
+                "wii_index": wi,
+                "best_jp": cands[0][1],
+                "best_mad": round(cands[0][0], 3),
+                "second_jp": cands[1][1],
+                "second_mad": round(cands[1][0], 3),
+                "reason": "ambiguous_wii_match",
+            }
+
+    all_pairs.sort()
+    for mad, wi, ji in all_pairs:
+        if wi in wii_to_jp or wi in ambiguous_wii or ji in used_jp:
+            continue
+        wii_to_jp[wi] = ji
+        used_jp.add(ji)
+
+    out_texs: List[Dict[str, object]] = [dict(wt) for wt in w_texs]
+    replaced_indices: List[int] = []
+    reencoded_indices: List[int] = []
+    skipped: List[Dict[str, object]] = []
+    preview_rows: List[
+        Tuple[int, int, int, str, Tuple[int, int, bytes], Tuple[int, int, bytes], Tuple[int, int, bytes]]
+    ] = []
+
+    for wi, info in sorted(ambiguous_wii.items()):
+        skipped.append(info)
+
+    for wi, wt in enumerate(w_texs):
+        ji = wii_to_jp.get(wi)
+        if ji is None:
+            continue
+        ti = explicit_target_map.get(wi) if explicit_target_map is not None else None
+        if ti is None:
+            ti = jp_to_tgt.get(ji)
+        if ti is None:
+            skipped.append({"wii_index": wi, "jp_index": ji, "reason": "no_target_match"})
+            continue
+        if j_dec[ji][4] == t_dec[ti][4]:
+            continue  # Not changed between GC-JP and GC-target
+        ww, wh, w_fmt = int(wt["width"]), int(wt["height"]), int(wt["fmt"])
+        tw, th, t_fmt, trgba, _ = t_dec[ti]
+        wrgba = w_dec[wi][3]
+        jrgba = j_dec[ji][3]
+        if text_wii_indices is not None:
+            dec = text_wii_indices.get(wi)
+            if dec is None:
+                skipped.append({"wii_index": wi, "jp_index": ji, "target_index": ti, "reason": "unlisted_non_text"})
+                preview_rows.append((wi, ji, ti, "SKIP unlisted", (ww, wh, wrgba), (j_dec[ji][0], j_dec[ji][1], jrgba), (ww, wh, wrgba)))
+                continue
+            if not dec[0]:
+                skipped.append({"wii_index": wi, "jp_index": ji, "target_index": ti, "reason": "non_text_graphic", "detail": dec[1]})
+                preview_rows.append((wi, ji, ti, "SKIP non-text", (ww, wh, wrgba), (j_dec[ji][0], j_dec[ji][1], jrgba), (ww, wh, wrgba)))
+                continue
+        if ww != tw or wh != th:
+            if not allow_aspect_fit:
+                skipped.append(
+                    {
+                        "wii_index": wi,
+                        "jp_index": ji,
+                        "target_index": ti,
+                        "reason": "dimension_mismatch",
+                        "wii": [ww, wh],
+                        "target": [tw, th],
+                    }
+                )
+                continue
+            if w_fmt not in (0, 1, 2, 3, 4, 5, 6, 14):
+                skipped.append(
+                    {"wii_index": wi, "jp_index": ji, "reason": "unsupported_wii_format", "wii_fmt": w_fmt}
+                )
+                continue
+            fitted_rgba = _fit_rgba_aspect(trgba, tw, th, ww, wh)
+            enc = _encode_tpl_pixels(fitted_rgba, ww, wh, w_fmt)
+            out_texs[wi]["data"] = enc
+            out_texs[wi]["pal_fmt"] = None
+            out_texs[wi]["pal_data"] = None
+            reencoded_indices.append(wi)
+            res_rgba = bytes(_decode_tpl_pixels(enc, ww, wh, w_fmt))
+            preview_rows.append((wi, ji, ti, "REPLACED (text, fit)", (ww, wh, wrgba), (j_dec[ji][0], j_dec[ji][1], jrgba), (ww, wh, res_rgba)))
+            continue
+        tt = t_texs[ti]
+        if w_fmt == t_fmt and wt["pal_fmt"] == tt["pal_fmt"]:
+            out_texs[wi]["data"] = tt["data"]
+            out_texs[wi]["pal_data"] = tt["pal_data"]
+            replaced_indices.append(wi)
+            res_rgba = trgba
+        else:
+            if w_fmt not in (0, 1, 2, 3, 4, 5, 6, 14):
+                skipped.append(
+                    {"wii_index": wi, "jp_index": ji, "reason": "unsupported_wii_format", "wii_fmt": w_fmt}
+                )
+                continue
+            enc = _encode_tpl_pixels(trgba, ww, wh, w_fmt)
+            out_texs[wi]["data"] = enc
+            out_texs[wi]["pal_fmt"] = None
+            out_texs[wi]["pal_data"] = None
+            reencoded_indices.append(wi)
+            res_rgba = bytes(_decode_tpl_pixels(enc, ww, wh, w_fmt))
+        preview_rows.append((wi, ji, ti, "REPLACED (text)", (ww, wh, wrgba), (j_dec[ji][0], j_dec[ji][1], jrgba), (ww, wh, res_rgba)))
+
+    # Also report any differing JP->target textures that had no Wii match
+    mapped_jps = set(wii_to_jp.values())
+    for ji, ti in sorted(jp_to_tgt.items()):
+        if j_dec[ji][4] != t_dec[ti][4] and ji not in mapped_jps:
+            skipped.append(
+                {
+                    "jp_index": ji,
+                    "target_index": ti,
+                    "reason": "no_wii_match",
+                    "jp": [j_dec[ji][0], j_dec[ji][1]],
+                    "target": [t_dec[ti][0], t_dec[ti][1]],
+                }
+            )
+
+    if preview_path is not None:
+        _render_misc_preview(preview_path, preview_rows)
+
+    new_b = _build_tpl(out_texs) if (replaced_indices or reencoded_indices) else wii_tpl
+    return new_b, {
+        "reason": "texturewise_jp_mapped" if (replaced_indices or reencoded_indices) else "no_matching_text_changes",
+        "mapped_textures": len(wii_to_jp),
+        "replaced_indices": replaced_indices,
+        "reencoded_indices": reencoded_indices,
+        "skipped": skipped,
+    }
+
+
+SINGLE_BYTE_FONT_VA = 0x80335120
+SINGLE_BYTE_FONT_ATLAS_DELTA = 0xC40
+SINGLE_BYTE_FONT_ATLAS_SIZE = 0x20000
+
+
+def _dol_va_to_offset(dol_bytes: bytes, va: int) -> int:
+    if len(dol_bytes) < 0x100:
+        raise ValueError("DOL too short")
+    sec_offs = struct.unpack_from(">18I", dol_bytes, 0x00)
+    sec_addrs = struct.unpack_from(">18I", dol_bytes, 0x48)
+    sec_sizes = struct.unpack_from(">18I", dol_bytes, 0x90)
+    for off, addr, sz in zip(sec_offs, sec_addrs, sec_sizes):
+        if sz > 0 and addr <= va < addr + sz:
+            return off + (va - addr)
+    raise ValueError(f"Virtual address 0x{va:08x} not found in DOL sections")
+
+
+def load_dol_single_byte_font(
+    dol_bytes: bytes, font_va: int = SINGLE_BYTE_FONT_VA
+) -> Tuple[List[Tuple[int, int, int]], bytes]:
+    """Load gSingleByteGlyphMetrics[256] and 512x512 I4 font atlas RGBA from Wii main.dol."""
+    hdr_off = _dol_va_to_offset(dol_bytes, font_va)
+    if hdr_off + SINGLE_BYTE_FONT_ATLAS_DELTA + SINGLE_BYTE_FONT_ATLAS_SIZE > len(dol_bytes):
+        raise ValueError("Single-byte font data extends past end of DOL")
+    metrics = [
+        struct.unpack_from(">3I", dol_bytes, hdr_off + 0x30 + i * 12) for i in range(256)
+    ]
+    atlas_raw = dol_bytes[
+        hdr_off + SINGLE_BYTE_FONT_ATLAS_DELTA : hdr_off + SINGLE_BYTE_FONT_ATLAS_DELTA + SINGLE_BYTE_FONT_ATLAS_SIZE
+    ]
+    atlas_rgba = bytes(_decode_tpl_pixels(atlas_raw, 512, 512, 0))
+    return metrics, atlas_rgba
+
+
+def _dol_glyph_code(byte_val: int, metrics: Sequence[Tuple[int, int, int]]) -> int:
+    """Use the DOL font's short hyphen (0xAD, 10px) instead of the wide dash (0x2D, 17px) when available."""
+    if byte_val == 0x2D and len(metrics) > 0xAD and metrics[0xAD][2] > 0:
+        return 0xAD
+    return byte_val
+
+
+def _measure_dol_text_width(text: str, metrics: Sequence[Tuple[int, int, int]]) -> int:
+    raw = text.encode("latin-1", errors="replace")
+    return sum(int(metrics[_dol_glyph_code(b, metrics)][2]) for b in raw)
+
+
+# The mod's first screen. The game shows textures 0 and 1 of logo.tpl (logow.tpl on a 16:9 screen) one after the
+# other; in retail they are the Wii Remote strap warnings. The mod puts a plain sentence there over the diagonal
+# stripes of the game's screen wipe, drawn with the game's own font and stripe texture from the user's disc.
+PRESS_A_STRIPES = 119  # misc.tpl: the diagonal stripes, 16x16 and repeating
+PRESS_A_STRIPE_SCALE = 6
+PRESS_A_STRIPE_COLOR = (40, 40, 40)
+PRESS_A_SHIFT = (0.0, 0.5)  # the second page's stripes sit half a period on, a step of the wipe's scroll
+
+
+def _draw_dol_text_centered(
+    img: Image.Image,
+    atlas_img: Image.Image,
+    metrics: Sequence[Tuple[int, int, int]],
+    text: str,
+    center_x: float,
+    y: float,
+    scale: float,
+    color: Tuple[int, int, int],
+) -> None:
+    raw = text.encode("latin-1", errors="replace")
+    x = center_x - _measure_dol_text_width(text, metrics) * scale / 2
+    glyph_h = max(1, round(24 * scale))
+    for b in raw:
+        gx, gy, gw = metrics[_dol_glyph_code(b, metrics)]
+        if gw > 0:
+            scaled_w = max(1, round(gw * scale))
+            cell = atlas_img.crop((gx, gy, gx + gw, gy + 24)).resize((scaled_w, glyph_h), Image.Resampling.LANCZOS)
+            img.paste(Image.new("RGBA", (scaled_w, glyph_h), (*color, 255)), (round(x), round(y)), cell.split()[0])
+        x += gw * scale
+
+
+def _stripe_slope(stripes: Image.Image) -> float:
+    """How far the stripes move to the right from one row of the texture to the next: the straight line that
+    fits all rows best."""
+    w, h = stripes.size
+    px = list(stripes.getdata())
+
+    def error(slope: float) -> int:
+        return sum(abs(px[y * w + x] - px[(x - round(slope * y)) % w]) for y in range(h) for x in range(w))
+
+    return min((k / 24 for k in range(-48, 49)), key=error)
+
+
+def render_press_a_image(
+    w: int,
+    h: int,
+    lines: Sequence[str],
+    metrics: Sequence[Tuple[int, int, int]],
+    atlas_rgba: bytes,
+    stripes: Image.Image,
+    shift: float,
+) -> bytes:
+    """One page: `lines` centred on the stripes, which start `shift` of a period to the right."""
+    lum = stripes.split()[0]
+    # The game shows one row of this texture at a time and its bottom edge does not meet its top edge, so the
+    # field is drawn from the top row alone, moved on from line to line by the texture's own slope
+    period = lum.width * PRESS_A_STRIPE_SCALE
+    strip = Image.new("L", (lum.width * 3, 1))
+    for i in range(3):
+        strip.paste(lum.crop((0, 0, lum.width, 1)), (i * lum.width, 0))
+    strip = strip.resize((period * 3, 1), Image.Resampling.BICUBIC).crop((period, 0, period * 2, 1))
+    slope = _stripe_slope(lum)
+    field = Image.new("L", (w, h))
+    for y in range(h):
+        for x in range(round(slope * y + shift * period) % period - period, w, period):
+            field.paste(strip, (x, y))
+    img = Image.new("RGBA", (w, h), (0, 0, 0, 255))
+    img.paste(Image.new("RGBA", (w, h), (*PRESS_A_STRIPE_COLOR, 255)), (0, 0), field)
+
+    atlas_img = Image.frombytes("RGBA", (512, 512), atlas_rgba)
+    # shrink a line that would not fit the 4:3 picture's safe width
+    scales = [min(1.25 if i == 0 else 0.85, 560 / max(1, _measure_dol_text_width(text, metrics))) for i, text in enumerate(lines)]
+    y = (h - sum(24 * scale * 1.6 for scale in scales)) / 2
+    for i, (text, scale) in enumerate(zip(lines, scales)):
+        _draw_dol_text_centered(img, atlas_img, metrics, text, w / 2, y, scale, (255, 255, 255) if i == 0 else (190, 190, 190))
+        y += 24 * scale * 1.6
+    return img.tobytes()
+
+
+def press_a_tpl(
+    wii_tpl: bytes,
+    misc_tpl: bytes,
+    lines: Sequence[str],
+    font_metrics: Sequence[Tuple[int, int, int]],
+    font_atlas_rgba: bytes,
+    preview_dir: Optional[Path] = None,
+    preview_prefix: str = "",
+) -> bytes:
+    """logo.tpl / logow.tpl with textures 0 and 1 replaced by the mod's "press A" pages."""
+    texs = parse_tpl_textures(wii_tpl)
+    if len(texs) < 2:
+        raise ValueError(f"Expected at least 2 textures in the logo TPL, got {len(texs)}")
+    t = parse_tpl_textures(misc_tpl)[PRESS_A_STRIPES]
+    size = (int(t["width"]), int(t["height"]))
+    stripes = Image.frombytes("RGBA", size, bytes(_decode_tpl_pixels(bytes(t["data"]), size[0], size[1], int(t["fmt"]))))
+
+    out_texs = [dict(t) for t in texs]
+    for idx in (0, 1):
+        t = out_texs[idx]
+        w, h, fmt = int(t["width"]), int(t["height"]), int(t["fmt"])
+        rgba = render_press_a_image(w, h, lines, font_metrics, font_atlas_rgba, stripes, PRESS_A_SHIFT[idx])
+        if preview_dir is not None:
+            preview_dir.mkdir(parents=True, exist_ok=True)
+            Image.frombytes("RGBA", (w, h), rgba).save(preview_dir / f"{preview_prefix}_{idx}.png")
+        t["data"] = _encode_tpl_pixels(rgba, w, h, fmt)
+    return _build_tpl(out_texs)
+
+
+BRRES_DAT_PAIRS: Tuple[Tuple[str, str], ...] = (
+    ("Item/love_letter.brres", "Item/love_letter.dat"),
+    ("Item/tonpy_item_p.brres", "Item/tonpy_item_p.dat"),
+    ("chibihouse/denti2con.brres", "chibihouse/denti2con.dat"),
+    ("kitchen/gus_up.brres", "kitchen/gus_up.dat"),
+    ("living/tako.brres", "living/tako.dat"),
+    ("how_to_chibirobo/cb_book.brres", "how_to_chibirobo/cb_book.dat"),
+)
+
+
+def _tex_data_size_mips(w: int, h: int, fmt: int, mip_count: int) -> int:
+    total = 0
+    for m in range(mip_count):
+        mw = max(1, w >> m)
+        mh = max(1, h >> m)
+        total += _tpl_data_size(mw, mh, fmt)
+    return total
+
+
+def parse_brres_textures(b: bytes) -> List[Dict[str, object]]:
+    """Parse TEX0 textures from a BRRES archive's Textures(NW4R) folder."""
+    if len(b) < 16 or b[:4] != b"bres":
+        raise ValueError("Invalid BRRES header")
+    hdr_size = struct.unpack_from(">H", b, 12)[0]
+    if b[hdr_size : hdr_size + 4] != b"root":
+        raise ValueError("Missing BRRES root section")
+
+    def read_idx_group(off: int) -> List[Tuple[str, int]]:
+        _, num_entries = struct.unpack_from(">II", b, off)
+        entries: List[Tuple[str, int]] = []
+        for i in range(1, num_entries + 1):
+            e_off = off + 8 + i * 16
+            _, _, _, _, name_off, data_off = struct.unpack_from(">HHHHII", b, e_off)
+            name_abs = off + name_off
+            name_end = b.index(b"\x00", name_abs)
+            name = b[name_abs:name_end].decode("ascii", "replace")
+            entries.append((name, off + data_off))
+        return entries
+
+    texs: List[Dict[str, object]] = []
+    for folder_name, folder_off in read_idx_group(hdr_size + 8):
+        if folder_name != "Textures(NW4R)":
+            continue
+        for tex_name, tex_off in read_idx_group(folder_off):
+            if b[tex_off : tex_off + 4] != b"TEX0":
+                raise ValueError(f"Expected TEX0 at 0x{tex_off:x}")
+            _, ver, _, data_off, _, has_pal, w, h, fmt, mip_cnt = struct.unpack_from(
+                ">IIiIiIHHII", b, tex_off + 4
+            )
+            if fmt not in TPL_FMT_SPECS:
+                continue
+            d_abs = tex_off + data_off
+            d_len = _tex_data_size_mips(w, h, fmt, mip_cnt)
+            lvl0_len = _tpl_data_size(w, h, fmt)
+            texs.append(
+                {
+                    "name": tex_name,
+                    "version": ver,
+                    "has_pal": has_pal,
+                    "width": w,
+                    "height": h,
+                    "fmt": fmt,
+                    "mip_count": mip_cnt,
+                    "data_abs_offset": d_abs,
+                    "data_len": d_len,
+                    "lvl0_len": lvl0_len,
+                    "data": b[d_abs : d_abs + d_len],
+                }
+            )
+    return texs
+
+
+def parse_dat_unique_images(b: bytes) -> List[Dict[str, object]]:
+    """Extract unique HSD_ImageDesc image entries from a GC .dat archive."""
+    if len(b) < 0x20:
+        raise ValueError("DAT archive too short")
+    _, data_size, reloc_cnt, _, _ = struct.unpack_from(">5I", b, 0)
+    reloc_table_off = 0x20 + data_size
+    if reloc_table_off + reloc_cnt * 4 > len(b):
+        raise ValueError("DAT relocation table out of bounds")
+    relocs = sorted(set(struct.unpack_from(f">{reloc_cnt}I", b, reloc_table_off)))
+    seen_ptrs = set()
+    images: List[Dict[str, object]] = []
+    for r in relocs:
+        if r + 0x18 > data_size:
+            continue
+        img_ptr, w, h, fmt, mipmap, min_lod, max_lod = struct.unpack_from(">IHHIIff", b, 0x20 + r)
+        if fmt not in TPL_FMT_SPECS or not (4 <= w <= 1024 and 4 <= h <= 1024):
+            continue
+        if mipmap not in (0, 1) or img_ptr >= data_size:
+            continue
+        if not (0.0 <= min_lod <= 10.0 and 0.0 <= max_lod <= 10.0):
+            continue
+        sz = _tpl_data_size(w, h, fmt)
+        if img_ptr + sz > data_size or img_ptr in seen_ptrs:
+            continue
+        seen_ptrs.add(img_ptr)
+        data = b[0x20 + img_ptr : 0x20 + img_ptr + sz]
+        images.append(
+            {
+                "reloc_off": r,
+                "img_ptr": img_ptr,
+                "width": w,
+                "height": h,
+                "fmt": fmt,
+                "mipmap": mipmap,
+                "data": data,
+                "md5": hashlib.md5(data).hexdigest(),
+            }
+        )
+    return images
+
+
+def _map_jp_to_target_dat_images(
+    jp_imgs: List[Dict[str, object]], tgt_imgs: List[Dict[str, object]]
+) -> Dict[int, int]:
+    """Map GC-JP unique image indices to GC-US/PAL indices via exact-hash anchors."""
+    jp_keys = [str(im["md5"]) for im in jp_imgs]
+    tgt_keys = [str(im["md5"]) for im in tgt_imgs]
+    sm = difflib.SequenceMatcher(None, jp_keys, tgt_keys, autojunk=False)
+    mapping: Dict[int, int] = {}
+    for tag, i1, i2, j1, j2 in sm.get_opcodes():
+        if tag == "equal":
+            for k in range(i2 - i1):
+                mapping[i1 + k] = j1 + k
+        elif tag == "replace":
+            # Match remaining items within the gap by (width, height, fmt) counts
+            by_sig_jp: Dict[Tuple[int, int, int], List[int]] = {}
+            by_sig_tgt: Dict[Tuple[int, int, int], List[int]] = {}
+            for ji in range(i1, i2):
+                im = jp_imgs[ji]
+                by_sig_jp.setdefault((int(im["width"]), int(im["height"]), int(im["fmt"])), []).append(ji)
+            for ti in range(j1, j2):
+                im = tgt_imgs[ti]
+                by_sig_tgt.setdefault((int(im["width"]), int(im["height"]), int(im["fmt"])), []).append(ti)
+            for sig, j_list in by_sig_jp.items():
+                t_list = by_sig_tgt.get(sig, [])
+                if len(j_list) == len(t_list):
+                    for ji, ti in zip(j_list, t_list):
+                        mapping[ji] = ti
+    return mapping
+
+
+def _mean_abs_rgba_diff(a: bytes, b: bytes) -> float:
+    return sum(abs(x - y) for x, y in zip(a, b)) / len(a)
+
+
+def _downsample_rgba_2x(rgba: bytes, w: int, h: int) -> Tuple[bytes, int, int]:
+    nw = max(1, w // 2)
+    nh = max(1, h // 2)
+    out = bytearray(nw * nh * 4)
+    for y in range(nh):
+        y0 = min(y * 2, h - 1)
+        y1 = min(y * 2 + 1, h - 1)
+        for x in range(nw):
+            x0 = min(x * 2, w - 1)
+            x1 = min(x * 2 + 1, w - 1)
+            i00 = (y0 * w + x0) * 4
+            i10 = (y0 * w + x1) * 4
+            i01 = (y1 * w + x0) * 4
+            i11 = (y1 * w + x1) * 4
+            dst = (y * nw + x) * 4
+            for c in range(4):
+                out[dst + c] = (rgba[i00 + c] + rgba[i10 + c] + rgba[i01 + c] + rgba[i11 + c] + 2) >> 2
+    return bytes(out), nw, nh
+
+
+def _encode_mip_tail(rgba0: bytes, w: int, h: int, fmt: int, mip_count: int) -> bytes:
+    out = bytearray()
+    cur_rgba, cur_w, cur_h = rgba0, w, h
+    for _ in range(1, mip_count):
+        cur_rgba, cur_w, cur_h = _downsample_rgba_2x(cur_rgba, cur_w, cur_h)
+        out.extend(_encode_tpl_pixels(cur_rgba, cur_w, cur_h, fmt))
+    return bytes(out)
+
+
+def _encode_with_mipmaps(rgba0: bytes, w: int, h: int, fmt: int, mip_count: int) -> bytes:
+    return _encode_tpl_pixels(rgba0, w, h, fmt) + _encode_mip_tail(rgba0, w, h, fmt, mip_count)
+
+
+def parse_dat_model_page_structure(b: bytes) -> Dict[str, object]:
+    """Extract JObj->TObj usage in model order and TexAnim imagetbl sequences from a GC .dat."""
+    if len(b) < 0x20:
+        raise ValueError("DAT archive too short")
+    _, data_size, reloc_cnt, root_cnt, _ = struct.unpack_from(">5I", b, 0)
+    reloc_table_off = 0x20 + data_size
+    if reloc_table_off + reloc_cnt * 4 > len(b):
+        raise ValueError("DAT relocation table out of bounds")
+    relocs = set(struct.unpack_from(f">{reloc_cnt}I", b, reloc_table_off))
+    imgs = parse_dat_unique_images(b)
+    ptr_to_uidx = {int(im["img_ptr"]): idx for idx, im in enumerate(imgs)}
+
+    def _read_imgdesc(off: int) -> Optional[Tuple[int, int, int, int]]:
+        if off == 0 or off + 0x18 > data_size:
+            return None
+        img_ptr, w, h, fmt, _, _, _ = struct.unpack_from(">IHHIIff", b, 0x20 + off)
+        if fmt not in TPL_FMT_SPECS or img_ptr not in ptr_to_uidx:
+            return None
+        return ptr_to_uidx[img_ptr], w, h, fmt
+
+    # 1. TexAnim imagetbl sequences (in file order)
+    texanims: List[List[int]] = []
+    seen_tbl_ptrs = set()
+    for r in sorted(relocs):
+        if r + 12 > data_size:
+            continue
+        tbl_ptr = struct.unpack_from(">I", b, 0x20 + r)[0]
+        if tbl_ptr == 0 or tbl_ptr in seen_tbl_ptrs or tbl_ptr + 4 > data_size or tbl_ptr not in relocs:
+            continue
+        n_img, n_tlut = struct.unpack_from(">HH", b, 0x20 + r + 8)
+        if not (2 <= n_img <= 32 and n_tlut <= 32) or tbl_ptr + n_img * 4 > data_size:
+            continue
+        first_desc = struct.unpack_from(">I", b, 0x20 + tbl_ptr)[0]
+        if _read_imgdesc(first_desc) is None:
+            continue
+        seq: List[int] = []
+        valid = True
+        for k in range(n_img):
+            doff = struct.unpack_from(">I", b, 0x20 + tbl_ptr + k * 4)[0]
+            res = _read_imgdesc(doff)
+            if res is None:
+                valid = False
+                break
+            seq.append(res[0])
+        if valid:
+            seen_tbl_ptrs.add(tbl_ptr)
+            texanims.append(seq)
+
+    # 2. Walk JObj -> DObj -> MObj -> TObj from scene_data if present
+    jobj_tobjs: List[Tuple[int, List[Tuple[int, int, int, int]]]] = []
+    root_off = reloc_table_off + reloc_cnt * 4
+    if root_cnt >= 1 and root_off + 8 <= len(b):
+        scene_off = struct.unpack_from(">I", b, root_off)[0]
+        if scene_off + 4 <= data_size:
+            models_ptr = struct.unpack_from(">I", b, 0x20 + scene_off)[0]
+            if 0 < models_ptr <= data_size - 4:
+                model_set_ptr = struct.unpack_from(">I", b, 0x20 + models_ptr)[0]
+                if 0 < model_set_ptr <= data_size - 4:
+                    jobj_root = struct.unpack_from(">I", b, 0x20 + model_set_ptr)[0]
+                    seen_j = set()
+
+                    def _walk(joff: int) -> None:
+                        if joff == 0 or joff in seen_j or joff + 0x14 > data_size:
+                            return
+                        seen_j.add(joff)
+                        _, _, child, nxt, u_ptr = struct.unpack_from(">5I", b, 0x20 + joff)
+                        d_ptr = u_ptr
+                        t_list: List[Tuple[int, int, int, int]] = []
+                        seen_d = set()
+                        while d_ptr and d_ptr not in seen_d and d_ptr + 0x10 <= data_size:
+                            seen_d.add(d_ptr)
+                            _, d_nxt, m_ptr, _ = struct.unpack_from(">4I", b, 0x20 + d_ptr)
+                            if m_ptr and m_ptr + 0x10 <= data_size:
+                                t_ptr = struct.unpack_from(">I", b, 0x20 + m_ptr + 0x08)[0]
+                                seen_t = set()
+                                while t_ptr and t_ptr not in seen_t and t_ptr + 0x50 <= data_size:
+                                    seen_t.add(t_ptr)
+                                    _, t_nxt, _, _ = struct.unpack_from(">4I", b, 0x20 + t_ptr)
+                                    img_desc = struct.unpack_from(">I", b, 0x20 + t_ptr + 0x4C)[0]
+                                    res = _read_imgdesc(img_desc)
+                                    if res is not None:
+                                        t_list.append(res)
+                                    t_ptr = t_nxt
+                            d_ptr = d_nxt
+                        if t_list:
+                            jobj_tobjs.append((joff, t_list))
+                        _walk(child)
+                        _walk(nxt)
+
+                    _walk(jobj_root)
+
+    return {"images": imgs, "texanims": texanims, "jobj_tobjs": jobj_tobjs}
+
+
+def _map_cb_book_by_structure(
+    w_texs: List[Dict[str, object]],
+    jp_struct: Dict[str, object],
+    tgt_struct: Dict[str, object],
+    max_mad: float = 15.0,
+) -> Tuple[Dict[str, Tuple[int, int]], List[Dict[str, object]]]:
+    """Map Wii cb_book.brres page textures to (jp_img_idx, tgt_img_idx) via .dat model structure."""
+    jp_imgs: List[Dict[str, object]] = jp_struct["images"]  # type: ignore[assignment]
+    tgt_imgs: List[Dict[str, object]] = tgt_struct["images"]  # type: ignore[assignment]
+    jp_anims: List[List[int]] = jp_struct["texanims"]  # type: ignore[assignment]
+    tgt_anims: List[List[int]] = tgt_struct["texanims"]  # type: ignore[assignment]
+    jp_jobjs: List[Tuple[int, List[Tuple[int, int, int, int]]]] = jp_struct["jobj_tobjs"]  # type: ignore[assignment]
+    tgt_jobjs: List[Tuple[int, List[Tuple[int, int, int, int]]]] = tgt_struct["jobj_tobjs"]  # type: ignore[assignment]
+
+    def _dedup_anims(anims: List[List[int]]) -> List[List[int]]:
+        seen_a = set()
+        out_a: List[List[int]] = []
+        for seq in anims:
+            key = tuple(seq)
+            if key not in seen_a:
+                seen_a.add(key)
+                out_a.append(seq)
+        return out_a
+
+    jp_u_anims = _dedup_anims(jp_anims)
+    tgt_u_anims = _dedup_anims(tgt_anims)
+
+    # Pair JP and Target TexAnims by (frame0_w, frame0_h, len)
+    by_name = {str(wt["name"]): wt for wt in w_texs}
+    mapping: Dict[str, Tuple[int, int]] = {}
+    extra_skipped: List[Dict[str, object]] = []
+
+    def _best_wii_prefix(seq: List[int]) -> Optional[str]:
+        f0 = jp_imgs[seq[0]]
+        fw, fh, ffmt = int(f0["width"]), int(f0["height"]), int(f0["fmt"])
+        f0_rgba = bytes(_decode_tpl_pixels(bytes(f0["data"]), fw, fh, ffmt))
+        best_p: Optional[Tuple[float, str]] = None
+        for prefix in ("page_L", "page_R"):
+            wt = by_name.get(f"{prefix}.1")
+            if wt is None or int(wt["width"]) != fw or int(wt["height"]) != fh:
+                continue
+            w_rgba = bytes(_decode_tpl_pixels(bytes(wt["data"])[: int(wt["lvl0_len"])], fw, fh, int(wt["fmt"])))
+            mad = _mean_abs_rgba_diff(w_rgba, f0_rgba)
+            if best_p is None or mad < best_p[0]:
+                best_p = (mad, prefix)
+        return best_p[1] if (best_p is not None and best_p[0] <= max_mad) else None
+
+    anim_prefix_imgs: Dict[str, Tuple[int, int]] = {}
+    used_tgt_anims = set()
+    for j_seq in jp_u_anims:
+        j0 = jp_imgs[j_seq[0]]
+        sig = (int(j0["width"]), int(j0["height"]), len(j_seq))
+        t_seq: Optional[List[int]] = None
+        for ti_a, cand in enumerate(tgt_u_anims):
+            if ti_a in used_tgt_anims:
+                continue
+            t0 = tgt_imgs[cand[0]]
+            if (int(t0["width"]), int(t0["height"]), len(cand)) == sig:
+                t_seq = cand
+                used_tgt_anims.add(ti_a)
+                break
+        if t_seq is None:
+            continue
+        prefix = _best_wii_prefix(j_seq)
+        if prefix is None:
+            continue
+        anim_prefix_imgs[prefix] = (j_seq[0], t_seq[0])
+        for idx, (ji, ti) in enumerate(zip(j_seq, t_seq), start=1):
+            tname = f"{prefix}.{idx}"
+            if tname in by_name:
+                mapping[tname] = (ji, ti)
+
+    # Static .0 pages via JObj model order:
+    # page_R.0 sits on the JObj containing page_R.1 (e.g. JObj 0.0.2.0);
+    # page_L.0 sits on the JObj group associated with page_L.1 (not the page_R JObj).
+    r1_j = anim_prefix_imgs.get("page_R", (-1, -1))
+    l1_j = anim_prefix_imgs.get("page_L", (-1, -1))
+
+    def _find_static_pages(
+        jobjs: List[Tuple[int, List[Tuple[int, int, int, int]]]],
+        r1_img: int,
+        l1_img: int,
+    ) -> Tuple[List[int], List[int]]:
+        r0_imgs: List[int] = []
+        l0_imgs: List[int] = []
+        for _, tlist in jobjs:
+            uids = [u for u, _, _, _ in tlist]
+            s128 = [u for u, w, h, _ in tlist if w == 128 and h == 128 and u != r1_img]
+            if r1_img in uids:
+                r0_imgs.extend(s128)
+            elif l1_img not in uids and s128:
+                l0_imgs.extend(s128)
+        return l0_imgs, r0_imgs
+
+    jp_l0, jp_r0 = _find_static_pages(jp_jobjs, r1_j[0], l1_j[0])
+    tgt_l0, tgt_r0 = _find_static_pages(tgt_jobjs, r1_j[1], l1_j[1])
+
+    l0_pair: Optional[Tuple[int, int]] = (jp_l0[0], tgt_l0[0]) if (jp_l0 and tgt_l0) else None
+    r0_pair: Optional[Tuple[int, int]] = (jp_r0[0], tgt_r0[0]) if (jp_r0 and tgt_r0) else None
+
+    if l0_pair is not None and r0_pair is not None and l0_pair[1] == r0_pair[1]:
+        # Only allow identical target image on both sides if target .dat uses it on both sides
+        if not (tgt_l0 and tgt_r0 and tgt_l0[0] == tgt_r0[0]):
+            r0_pair = None
+
+    if "page_L.0" in by_name and l0_pair is not None:
+        mapping["page_L.0"] = l0_pair
+    if "page_R.0" in by_name and r0_pair is not None:
+        mapping["page_R.0"] = r0_pair
+
+    # Report any extra distinct 128x128 target images on L/R that have no Wii texture slot
+    placed_tgt = {ti for _, ti in mapping.values()}
+    for side, extra_list in (("page_L", tgt_l0), ("page_R", tgt_r0)):
+        seen_ex = set()
+        for ti in extra_list:
+            if ti not in placed_tgt and ti not in seen_ex:
+                seen_ex.add(ti)
+                extra_skipped.append({"name": f"{side}.extra", "reason": "no_wii_slot", "target_image": ti})
+
+    return mapping, extra_skipped
+
+
+def _render_cb_book_preview(
+    preview_path: Path,
+    pages: Sequence[Tuple[str, str, int, int, bytes]],
+) -> None:
+    """Render cb_book pages in order (page_L.0..7, page_R.0..7) to a grid PNG."""
+    if not pages:
+        return
+    cols = 4
+    cell_w, cell_h = 276, 300
+    rows = (len(pages) + cols - 1) // cols
+    canvas = Image.new("RGBA", (cols * cell_w, rows * cell_h), (36, 36, 36, 255))
+    draw = ImageDraw.Draw(canvas)
+    for idx, (tname, info, pw, ph, rgba) in enumerate(pages):
+        r, c = divmod(idx, cols)
+        x0, y0 = c * cell_w + 10, r * cell_h + 10
+        draw.text((x0, y0), f"{tname} ({info})", fill=(240, 240, 240, 255))
+        im = Image.frombytes("RGBA", (pw, ph), rgba)
+        if pw > 256 or ph > 256:
+            im = im.resize((256, 256), Image.Resampling.BILINEAR)
+        canvas.paste(im, (x0, y0 + 24), im)
+    preview_path.parent.mkdir(parents=True, exist_ok=True)
+    canvas.save(preview_path)
+
+
+def replace_brres_textures(
+    wii_brres: bytes,
+    jp_dat: bytes,
+    tgt_dat: bytes,
+    max_mad: float = 15.0,
+    structural_book: bool = False,
+    preview_path: Optional[Path] = None,
+) -> Tuple[bytes, Dict[str, object]]:
+    """Replace text textures in a Wii BRRES using GC-JP -> GC-target image mapping."""
+    w_texs = parse_brres_textures(wii_brres)
+    jp_imgs = parse_dat_unique_images(jp_dat)
+    tgt_imgs = parse_dat_unique_images(tgt_dat)
+
+    struct_map: Dict[str, Tuple[int, int]] = {}
+    skipped: List[Dict[str, object]] = []
+    if structural_book:
+        jp_struct = parse_dat_model_page_structure(jp_dat)
+        tgt_struct = parse_dat_model_page_structure(tgt_dat)
+        struct_map, extra_sk = _map_cb_book_by_structure(w_texs, jp_struct, tgt_struct, max_mad=max_mad)
+        skipped.extend(extra_sk)
+        jp_to_tgt: Dict[int, int] = {}
+    else:
+        jp_to_tgt = _map_jp_to_target_dat_images(jp_imgs, tgt_imgs)
+
+    jp_rgba_cache: Dict[int, bytes] = {}
+    out = bytearray(wii_brres)
+    replaced: List[str] = []
+    reencoded: List[str] = []
+    unchanged: List[str] = []
+    book_mapping_rows: List[Dict[str, object]] = []
+    preview_pages: List[Tuple[str, str, int, int, bytes]] = []
+
+    for wt in w_texs:
+        tname = str(wt["name"])
+        w = int(wt["width"])
+        h = int(wt["height"])
+        w_fmt = int(wt["fmt"])
+        mips = int(wt["mip_count"])
+        lvl0_len = int(wt["lvl0_len"])
+        w_lvl0 = bytes(wt["data"])[:lvl0_len]
+
+        matched_ji: Optional[int] = None
+        ti_override: Optional[int] = None
+        if structural_book:
+            if tname in struct_map:
+                matched_ji, ti_override = struct_map[tname]
+            else:
+                if tname.startswith("page_"):
+                    skipped.append({"name": tname, "reason": "no_structural_match"})
+                else:
+                    unchanged.append(tname)
+                continue
+        else:
+            # Match Wii TEX0 to GC-JP image (exact bytes first, then decoded pixel MAD)
+            for ji, jim in enumerate(jp_imgs):
+                if int(jim["width"]) == w and int(jim["height"]) == h and int(jim["fmt"]) == w_fmt:
+                    if bytes(jim["data"]) == w_lvl0:
+                        matched_ji = ji
+                        break
+
+            if matched_ji is None:
+                if w_fmt not in TPL_FMT_SPECS or w_fmt in (8, 9):
+                    skipped.append({"name": tname, "reason": "unsupported_wii_format", "fmt": w_fmt})
+                    continue
+                w_rgba = bytes(_decode_tpl_pixels(w_lvl0, w, h, w_fmt))
+                best: Optional[Tuple[float, int]] = None
+                for ji, jim in enumerate(jp_imgs):
+                    if int(jim["width"]) != w or int(jim["height"]) != h:
+                        continue
+                    j_fmt = int(jim["fmt"])
+                    if j_fmt not in TPL_FMT_SPECS or j_fmt in (8, 9):
+                        continue
+                    if ji not in jp_rgba_cache:
+                        jp_rgba_cache[ji] = bytes(_decode_tpl_pixels(bytes(jim["data"]), w, h, j_fmt))
+                    mad = _mean_abs_rgba_diff(w_rgba, jp_rgba_cache[ji])
+                    if best is None or mad < best[0]:
+                        best = (mad, ji)
+                if best is not None and best[0] <= max_mad:
+                    matched_ji = best[1]
+
+        if matched_ji is None:
+            skipped.append({"name": tname, "reason": "no_jp_match", "width": w, "height": h, "fmt": w_fmt})
+            continue
+
+        if ti_override is None:
+            if matched_ji not in jp_to_tgt:
+                skipped.append({"name": tname, "reason": "no_target_match", "jp_index": matched_ji})
+                continue
+            ti = jp_to_tgt[matched_ji]
+        else:
+            ti = ti_override
+
+        jim = jp_imgs[matched_ji]
+        tim = tgt_imgs[ti]
+        if structural_book:
+            book_mapping_rows.append({"wii_name": tname, "jp_image": matched_ji, "target_image": ti})
+
+        # Only replace textures that differ from GC-JP (i.e. carry localized text)
+        if bytes(tim["data"]) == bytes(jim["data"]):
+            unchanged.append(tname)
+            if structural_book and preview_path is not None:
+                preview_pages.append((tname, f"JP{matched_ji}->US{ti} same", w, h, bytes(_decode_tpl_pixels(w_lvl0, w, h, w_fmt))))
+            continue
+
+        t_fmt = int(tim["fmt"])
+        if int(tim["width"]) != w or int(tim["height"]) != h:
+            skipped.append({"name": tname, "reason": "dimension_mismatch"})
+            if structural_book and preview_path is not None:
+                preview_pages.append((tname, f"JP{matched_ji}->US{ti} dim_skip", w, h, bytes(_decode_tpl_pixels(w_lvl0, w, h, w_fmt))))
+            continue
+
+        if w_fmt == t_fmt:
+            if mips == 1:
+                new_data = bytes(tim["data"])
+            else:
+                t_rgba = bytes(_decode_tpl_pixels(bytes(tim["data"]), w, h, t_fmt))
+                new_data = bytes(tim["data"]) + _encode_mip_tail(t_rgba, w, h, w_fmt, mips)
+            replaced.append(tname)
+        else:
+            if t_fmt not in TPL_FMT_SPECS or t_fmt in (8, 9) or w_fmt not in (0, 1, 2, 3, 4, 5, 6, 14):
+                skipped.append(
+                    {"name": tname, "reason": "unsupported_format_conversion", "wii_fmt": w_fmt, "gc_fmt": t_fmt}
+                )
+                continue
+            t_rgba = bytes(_decode_tpl_pixels(bytes(tim["data"]), w, h, t_fmt))
+            new_data = _encode_with_mipmaps(t_rgba, w, h, w_fmt, mips)
+            reencoded.append(tname)
+
+        d_abs = int(wt["data_abs_offset"])
+        d_len = int(wt["data_len"])
+        if len(new_data) != d_len:
+            skipped.append({"name": tname, "reason": "encoded_size_mismatch", "expected": d_len, "actual": len(new_data)})
+            continue
+        out[d_abs : d_abs + d_len] = new_data
+        if structural_book and preview_path is not None:
+            res_rgba = bytes(_decode_tpl_pixels(new_data[:lvl0_len], w, h, w_fmt))
+            preview_pages.append((tname, f"JP{matched_ji}->US{ti}", w, h, res_rgba))
+
+    if preview_path is not None and preview_pages:
+        _render_cb_book_preview(preview_path, preview_pages)
+
+    res_dict: Dict[str, object] = {
+        "replaced": replaced,
+        "reencoded": reencoded,
+        "unchanged": unchanged,
+        "skipped": skipped,
+    }
+    if structural_book:
+        res_dict["book_mapping"] = book_mapping_rows
+    return bytes(out), res_dict
+
+
+def _run_dtk(dtk: Path, args: Sequence[str]) -> str:
+    res = subprocess.run([str(dtk), *args], capture_output=True, text=True)
+    if res.returncode != 0:
+        raise RuntimeError(f"dtk {' '.join(args)} failed: {res.stderr.strip() or res.stdout.strip()}")
+    return res.stdout
+
+
+def _dtk_exists(dtk: Path, vfs_target: str) -> bool:
+    res = subprocess.run([str(dtk), "vfs", "ls", vfs_target], capture_output=True, text=True)
+    return res.returncode == 0
+
+
+def _auto_detect_jp_disc(wii_path: Path) -> Optional[Path]:
+    # Check <parent_of_R24J01>/GGTJ01_01/*.rvz or *.iso
+    jp_dir = wii_path.parent.parent / "GGTJ01_01"
+    if not jp_dir.is_dir():
+        return None
+    for ext in ("*.rvz", "*.iso", "*.gcm"):
+        matches = sorted(jp_dir.glob(ext))
+        if matches:
+            return matches[0]
+    return None
+
+
+def _extract_discs(
+    dtk: Path,
+    wii_disc: Path,
+    us_disc: Optional[Path],
+    pal_disc: Optional[Path],
+    jp_disc: Optional[Path],
+    work_dir: Path,
+) -> Dict[str, Path]:
+    paths = {
+        "wii_bin": work_dir / "wii" / "bin",
+        "wii_tpl": work_dir / "wii" / "tpl",
+        "us_bin_e": work_dir / "us" / "bin" / "e",
+        "us_tpl": work_dir / "us" / "tpl",
+        "pal_bin": work_dir / "pal" / "bin",
+        "pal_tpl": work_dir / "pal" / "tpl",
+    }
+    for p in paths.values():
+        if p.exists():
+            shutil.rmtree(p)
+        p.mkdir(parents=True, exist_ok=True)
+
+    _run_dtk(dtk, ["vfs", "cp", f"{wii_disc}:files/bin", str(paths["wii_bin"])])
+    _run_dtk(dtk, ["vfs", "cp", f"{wii_disc}:files/tpl", str(paths["wii_tpl"])])
+    if _dtk_exists(dtk, f"{wii_disc}:sys/main.dol"):
+        wii_dol = work_dir / "wii" / "sys" / "main.dol"
+        wii_dol.parent.mkdir(parents=True, exist_ok=True)
+        _run_dtk(dtk, ["vfs", "cp", f"{wii_disc}:sys/main.dol", str(wii_dol)])
+        paths["wii_dol"] = wii_dol
+    if us_disc is not None:
+        _run_dtk(dtk, ["vfs", "cp", f"{us_disc}:files/qp.bin:bin/e", str(paths["us_bin_e"])])
+        _run_dtk(dtk, ["vfs", "cp", f"{us_disc}:files/qp.bin:tpl", str(paths["us_tpl"])])
+    if pal_disc is not None:
+        for sub in ("e", "g", "f", "s", "i"):
+            dst = paths["pal_bin"] / sub
+            dst.mkdir(parents=True, exist_ok=True)
+            _run_dtk(dtk, ["vfs", "cp", f"{pal_disc}:files/qp.bin:bin/{sub}", str(dst)])
+        _run_dtk(dtk, ["vfs", "cp", f"{pal_disc}:files/qp.bin:tpl", str(paths["pal_tpl"])])
+
+    # Extract BRRES / DAT pairs for texture replacement
+    for disc_key, base in (
+        ("wii_brres", work_dir / "wii" / "brres"),
+        ("us_dat", work_dir / "us" / "dat"),
+        ("pal_dat", work_dir / "pal" / "dat"),
+    ):
+        if base.exists():
+            shutil.rmtree(base)
+        base.mkdir(parents=True, exist_ok=True)
+        paths[disc_key] = base
+    for br_rel, dat_rel in BRRES_DAT_PAIRS:
+        wii_dst = paths["wii_brres"] / br_rel
+        wii_dst.parent.mkdir(parents=True, exist_ok=True)
+        _run_dtk(dtk, ["vfs", "cp", f"{wii_disc}:files/{br_rel}", str(wii_dst)])
+        for disc, key in ((us_disc, "us_dat"), (pal_disc, "pal_dat")):
+            if disc is not None:
+                dst = paths[key] / dat_rel
+                dst.parent.mkdir(parents=True, exist_ok=True)
+                _run_dtk(dtk, ["vfs", "cp", f"{disc}:files/qp.bin:{dat_rel}", str(dst)])
+
+    if jp_disc is not None:
+        jp_bin = work_dir / "jp" / "bin"
+        if jp_bin.exists():
+            shutil.rmtree(jp_bin)
+        jp_bin.mkdir(parents=True, exist_ok=True)
+        _run_dtk(dtk, ["vfs", "cp", f"{jp_disc}:files/qp.bin:bin", str(jp_bin)])
+        paths["jp_bin"] = jp_bin
+
+        jp_dat = work_dir / "jp" / "dat"
+        if jp_dat.exists():
+            shutil.rmtree(jp_dat)
+        jp_dat.mkdir(parents=True, exist_ok=True)
+        for _, dat_rel in BRRES_DAT_PAIRS:
+            dst = jp_dat / dat_rel
+            dst.parent.mkdir(parents=True, exist_ok=True)
+            _run_dtk(dtk, ["vfs", "cp", f"{jp_disc}:files/qp.bin:{dat_rel}", str(dst)])
+        paths["jp_dat"] = jp_dat
+
+        jp_tpl = work_dir / "jp" / "tpl"
+        if jp_tpl.exists():
+            shutil.rmtree(jp_tpl)
+        jp_tpl.mkdir(parents=True, exist_ok=True)
+        _run_dtk(dtk, ["vfs", "cp", f"{jp_disc}:files/qp.bin:tpl", str(jp_tpl)])
+        paths["jp_tpl"] = jp_tpl
+    return paths
+
+
+def _write_depfile(depfile: Path, targets: Sequence[Path], deps: Sequence[Path]) -> None:
+    depfile.parent.mkdir(parents=True, exist_ok=True)
+    t_str = " ".join(str(t).replace(" ", "\\ ") for t in targets)
+    d_str = " ".join(str(d).replace(" ", "\\ ") for d in deps)
+    depfile.write_text(f"{t_str}: {d_str}\n", encoding="utf-8")
+
+
+def _tpl_counterpart_name(wii_name: str, suffix: str) -> str:
+    if wii_name == "logo.tpl":
+        return f"logo_{suffix}.tpl"
+    if wii_name == "title.tpl":
+        title_suffix = "en" if suffix == "us" else suffix
+        return f"title_{title_suffix}.tpl"
+    return wii_name
+
+
+def build_language_data(
+    dtk: Path,
+    wii_disc: Path,
+    us_disc: Optional[Path],
+    pal_disc: Optional[Path],
+    work_dir: Path,
+    out_dir: Path,
+    jp_disc: Optional[Path] = None,
+    depfile: Optional[Path] = None,
+) -> Dict[str, object]:
+    if us_disc is None and pal_disc is None:
+        raise ValueError("Give the GameCube disc of the US release (--us), of the European one (--pal), or both")
+    for label, p in (("dtk", dtk), ("wii", wii_disc), ("us", us_disc), ("pal", pal_disc)):
+        if p is not None and not p.exists():
+            raise FileNotFoundError(f"Missing --{label} path: {p}")
+    if jp_disc is not None and not jp_disc.exists():
+        raise FileNotFoundError(f"Missing --jp path: {jp_disc}")
+
+    if not _dtk_exists(dtk, f"{wii_disc}:files/bin"):
+        raise RuntimeError(f"Invalid Wii disc (files/bin missing): {wii_disc}")
+    for label, p in (("US", us_disc), ("PAL", pal_disc)):
+        if p is not None and not _dtk_exists(dtk, f"{p}:files/qp.bin"):
+            raise RuntimeError(f"Invalid {label} GC disc (files/qp.bin missing): {p}")
+
+    extracted = _extract_discs(dtk, wii_disc, us_disc, pal_disc, jp_disc, work_dir)
+    out_dir.mkdir(parents=True, exist_ok=True)
+
+    wii_fnt_empty = _dtk_exists(dtk, f"{wii_disc}:files/fnt") and not _run_dtk(
+        dtk, ["vfs", "ls", f"{wii_disc}:files/fnt"]
+    ).strip()
+
+    # Record Wii-only asset directories whose container format differs from GC (.brres/.thp vs .dat)
+    wii_asset_dirs = []
+    for d in ("Item", "how_to_chibirobo", "chibihouse", "kitchen", "living", "movie", "hbm"):
+        if _dtk_exists(dtk, f"{wii_disc}:files/{d}"):
+            wii_asset_dirs.append(d)
+
+    wii_bins = sorted(extracted["wii_bin"].glob("*.bin"))
+    wii_tpls = sorted(extracted["wii_tpl"].glob("*.tpl"))
+
+    press_a_path = Path(__file__).resolve().parent.parent / "mods" / "wii-localization" / "press_a.json"
+    press_a: Optional[Dict[str, List[str]]] = None
+    dol_font: Optional[Tuple[List[Tuple[int, int, int]], bytes]] = None
+    if press_a_path.exists() and "wii_dol" in extracted:
+        press_a = json.loads(press_a_path.read_text(encoding="utf-8"))
+        dol_font = load_dol_single_byte_font(extracted["wii_dol"].read_bytes())
+    misc_tpl = extracted["wii_tpl"] / "misc.tpl"
+    preview_dir = out_dir.parent / "preview"
+
+    report: Dict[str, object] = {
+        "jp_reference_used": jp_disc is not None,
+        "font": {
+            "status": "no_disc_font",
+            "wii_fnt_empty": wii_fnt_empty,
+            "pal_disc_font": False,
+            "note": "PAL/US 512x512 I4 single-byte font is compiled into main.dol (CFont::Init); R24J01 uses ROM font.",
+        },
+        "non_transferable_asset_dirs": wii_asset_dirs,
+        "languages": {},
+    }
+
+    written_files: List[Path] = []
+    for code, (disc_key, bin_sub, tpl_suffix) in language_specs(us_disc is not None, pal_disc is not None).items():
+        lang_out = out_dir / "lang" / code
+        if lang_out.exists():
+            shutil.rmtree(lang_out)
+
+        tgt_bin_dir = extracted["us_bin_e"] if disc_key == "us" else (extracted["pal_bin"] / bin_sub)
+        tgt_tpl_dir = extracted["us_tpl"] if disc_key == "us" else extracted["pal_tpl"]
+        jp_bin_dir = extracted.get("jp_bin")
+        jp_tpl_dir = extracted.get("jp_tpl")
+
+        transferred_files: List[str] = []
+        identical_files: List[str] = []
+        non_transferable_files: List[Dict[str, object]] = []
+        wii_only_files: List[str] = []
+        total_msgs = 0
+        translated_msgs = 0
+        untranslated_msgs = 0
+        per_bin_details: Dict[str, object] = {}
+
+        for wii_bin_path in wii_bins:
+            name = wii_bin_path.name
+            rel_path = f"bin/{name}"
+            wii_b = wii_bin_path.read_bytes()
+            tgt_path = tgt_bin_dir / name
