+import json
+import tempfile
+import unittest
+from pathlib import Path
+from xml.etree import ElementTree
+
+from tools.wii_locale import disc_image, write_header, write_localization, write_mod, write_text_tables
+
+
+class WiiLocaleTests(unittest.TestCase):
+    source = Path(__file__).resolve().parents[1] / "mods/wii-localization/interface.json"
+
+    def test_locales_emit_matching_descriptor_and_encoded_banner(self):
+        translations = json.loads(self.source.read_text(encoding="utf-8"))
+        with tempfile.TemporaryDirectory() as tmp:
+            for locale, strings in translations.items():
+                with self.subTest(locale=locale):
+                    output = Path(tmp) / locale
+                    base = Path(tmp) / "original.rvz"
+                    write_localization(self.source, locale, output)
+                    write_mod(output, base, f"{locale} localization")
+                    descriptor = json.loads((output / "game.json").read_text())
+                    self.assertEqual((output / descriptor["base-file"]).resolve(), base.resolve())
+                    patch = descriptor["riivolution"]["patches"][0]
+                    xml = ElementTree.parse(output / patch["xml"]).getroot()
+                    option = xml.find("options/section/option")
+                    self.assertEqual(option.get("id"), patch["options"][0]["option-id"])
+                    self.assertEqual(option.find("choice").get("name"), f"{locale} localization")
+                    self.assertEqual(xml.find("patch/file").get("disc"), "main.dol")
+                    header = (output / "include/wii_locale.h").read_text()
+                    for line in (1, 2):
+                        text = strings[line].encode("utf-16-be").hex()
+                        units = [f"0x{text[i:i+4]}" for i in range(0, len(text), 4)]
+                        self.assertIn(", ".join(units + ["0"]), header)
+                    self.assertIn(strings[3], header)
+
+    def test_wii_slots_and_five_translations(self):
+        mapping = json.loads(self.source.with_name("text_map.json").read_text())
+        records = json.loads(self.source.with_name("wii_text.json").read_text())
+        for record in records:
+            # an override replaces mapped text in the languages it names; a Wii-only text needs all five
+            if record.get("override"):
+                self.assertLessEqual(set(record["translations"]), {"en", "de", "fr", "es", "it"})
+            else:
+                self.assertEqual(set(record["translations"]), {"en", "de", "fr", "es", "it"})
+            for index in record["indices"]:
+                self.assertEqual(mapping["interface"][index] is not None, bool(record.get("override")))
+        # the save banner's title and play time come from the US slots past the Japanese table
+        self.assertEqual(mapping["interface"][264:268], [258, 259, 260, 261])
+        with tempfile.TemporaryDirectory() as tmp:
+            write_localization(self.source, "de-DE", Path(tmp))
+            header = (Path(tmp) / "include/wii_text.h").read_text()
+            for name, length in (("Interface", 301), ("PC", 24)):
+                values = header.split(f"s{name}Map[] = {{ ")[1].split(" };")[0]
+                self.assertEqual(len(values.split(", ")), length)
+
+    def test_override_keeps_mapped_text_in_other_languages(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            folder = Path(tmp)
+            interface = [None] * 301
+            interface[10] = 9
+            (folder / "text_map.json").write_text(json.dumps({"interface": interface, "pc": [None] * 24}))
+            record = {"indices": [10], "meaning": "test", "override": True, "translations": {"de": "Ja"}}
+            (folder / "wii_text.json").write_text(json.dumps([record]))
+            write_text_tables(folder, folder / "wii_text.h")
+            self.assertIn('{ 0, "\\112\\141", 0, 0, 0 }', (folder / "wii_text.h").read_text())
+            # without "override" a mapped slot is a mistake
+            del record["override"]
+            (folder / "wii_text.json").write_text(json.dumps([record]))
+            with self.assertRaises(ValueError):
+                write_text_tables(folder, folder / "wii_text.h")
+
+    def test_global_interface_and_disc_banner(self):
+        import hashlib
+        from tools.wii_locale import SYSTEM_LOCALES, opening_banner
+        strings = json.loads(self.source.read_text())
+        with tempfile.TemporaryDirectory() as tmp:
+            target = Path(tmp) / "global.h"
+            write_header(self.source, "global", target)
+            header = target.read_text()
+            for i, locale in enumerate(SYSTEM_LOCALES):
+                self.assertIn(f"sInterfaceRow{i}", header)
+                self.assertIn(strings[locale][3], header)
+        original = bytearray(0x640)
+        original[0x40:0x48] = b"IMET\0\0\x06\0"
+        original[0x5c:0x60] = "日本".encode("utf-16-be")
+        changed = opening_banner(original, {2: "Menü"})
+        self.assertEqual(changed[0x5c:0xb0], original[0x5c:0xb0])
+        self.assertEqual(changed[0x104:0x10c], "Menü".encode("utf-16-be"))
+        self.assertEqual(changed[0x5f0:0x600], hashlib.md5(changed[:0x5f0] + bytes(16)).digest())
+        self.assertEqual(changed[0x600:], original[0x600:])
+        with self.assertRaises(ValueError):
+            opening_banner(original, {2: "a" * 42})
+
+    def test_gamecube_pad_mod_without_localization(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            output = Path(tmp) / "wii-gcpad"
+            base = Path(tmp) / "original.rvz"
+            write_mod(output, base, "GameCube controller")
+            descriptor = json.loads((output / "game.json").read_text())
+            self.assertEqual(descriptor["display-name"], "Chibi-Robo! (Wii, GameCube controller)")
+            self.assertEqual((output / descriptor["base-file"]).resolve(), base.resolve())
+            self.assertFalse((output / "include/wii_locale.h").exists())
+
+    def test_disc_only_or_fully_extracted(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            folder = Path(tmp)
+            (folder / "sys").mkdir()
+            dol = folder / "sys/main.dol"
+            dol.touch()
+            with self.assertRaises(ValueError):
+                disc_image(folder)
+            (folder / "sys/boot.bin").touch()
+            (folder / "files").mkdir()
+            self.assertEqual(disc_image(folder), dol)
+            image = folder / "Chibi-Robo (Japan).RVZ"
+            image.touch()
+            self.assertEqual(disc_image(folder), image)
+
+    def test_rejects_overlong_banner_and_invalid_game_text(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            source = root / "locale.json"
+            for index, value in ((1, "x" * 32), (2, "😀" * 16), (3, "a\0b"), (4, "é")):
+                with self.subTest(index=index):
+                    strings = ["test"] * 6
+                    strings[index] = value
+                    source.write_text(json.dumps({"test": strings}))
+                    with self.assertRaises(ValueError):
+                        write_header(source, "test", root / "locale.h")
diff --git a/tools/test_wii_stage_names.py b/tools/test_wii_stage_names.py
new file mode 100644
index 0000000000000000000000000000000000000000..05ddc82852c1f182518d1eb660e32e1b31e689cf
--- /dev/null
+++ b/tools/test_wii_stage_names.py
@@ -0,0 +1,169 @@
+"""Synthetic retail-style metadata, with no game text or other disc assets."""
+
+import struct
+import os
+import hashlib
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from tools.wii_stage_names import build_overlay, write_overlay
+
+
+def local_file(names=None, marker=b"W"):
+    names = names or {}
+    data = bytearray(84)
+    for slot in range(21):
+        if slot in (15, 16, 17):
+            continue
+        start = len(data)
+        struct.pack_into("<I", data, slot * 4, start)
+        if slot not in (11, 13, 14):
+            data.extend(marker + bytes([slot]))
+            continue
+        count = {11: 64, 13: 9, 14: 30}[slot]
+        fields = 2 if slot == 14 else 1
+        data.extend(bytes(count * fields * 4))
+        for field in range(fields):
+            for index in range(count):
+                raw = names.get((slot, index, field), f"Field{slot}-{index}-{field}".encode())
+                pointer = start + 4 * (fields * index + field)
+                struct.pack_into("<I", data, pointer, len(data))
+                data.extend(raw + b"\0")
+    collision = marker + b"coll"
+    script = marker + b"script"
+    data_pad = bytes((-len(data)) % 4)
+    collision_pad = bytes((-len(collision)) % 4)
+    collision_pos = len(data) + len(data_pad)
+    script_pos = collision_pos + len(collision) + len(collision_pad)
+    header = struct.pack("<6I", 0, len(data), collision_pos, len(collision), script_pos, len(script))
+    return header + data + data_pad + collision + collision_pad + script + b"\xfa"
+
+
+def word(data, offset):
+    return struct.unpack_from("<I", data, offset)[0]
+
+
+def cell(blob, slot, index, field=0):
+    return 24 + word(blob, 24 + slot * 4) + 4 * ((2 if slot == 14 else 1) * index + field)
+
+
+def value(blob, slot, index, field=0):
+    start = 24 + word(blob, cell(blob, slot, index, field))
+    return blob[start:blob.index(b"\0", start)]
+
+
+class WiiStageNamesTest(unittest.TestCase):
+    def test_write_overlay_protects_inputs_and_existing_output(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            wii, gc, output = root / "wii.bin", root / "gc.bin", root / "out.bin"
+            base = local_file()
+            wii.write_bytes(base)
+            donor = local_file({(11, 0, 0): b"Changed"})
+            gc.write_bytes(donor)
+            output.write_bytes(b"previous output")
+            for alias in (wii, gc):
+                with self.assertRaisesRegex(ValueError, "different from both inputs"):
+                    write_overlay(gc, wii, alias)
+            with self.assertRaisesRegex(ValueError, "original R24J01"):
+                write_overlay(gc, wii, output)
+            self.assertEqual(output.read_bytes(), b"previous output")
+            # Only the private integration test can use the genuine target. Pin
+            # this synthetic file's digest to exercise the same guarded writer.
+            with patch("tools.wii_stage_names.R24J01_GLOBALS_SHA256", hashlib.sha256(base).hexdigest()):
+                nested = root / "files" / "bin" / "globals.bin"
+                write_overlay(gc, wii, nested)
+                self.assertEqual(value(nested.read_bytes(), 11, 0), b"Changed")
+                gc.write_bytes(b"truncated")
+                with self.assertRaisesRegex(ValueError, "truncated"):
+                    write_overlay(gc, wii, output)
+                self.assertEqual(output.read_bytes(), b"previous output")
+                gc.write_bytes(donor)
+                with patch("tools.wii_stage_names.os.replace", side_effect=OSError("replace failed")):
+                    with self.assertRaisesRegex(OSError, "replace failed"):
+                        write_overlay(gc, wii, output)
+                self.assertEqual({p.name for p in root.iterdir()}, {"wii.bin", "gc.bin", "out.bin", "files"})
+                self.assertEqual(output.read_bytes(), b"previous output")
+            self.assertEqual(wii.read_bytes(), base)
+            self.assertEqual(gc.read_bytes(), donor)
+
+    def test_output_cannot_be_a_hardlink_to_input(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            wii, gc, alias = root / "wii.bin", root / "gc.bin", root / "alias.bin"
+            wii.write_bytes(local_file())
+            gc.write_bytes(local_file(marker=b"G"))
+            try:
+                os.link(gc, alias)
+            except OSError as exc:
+                self.skipTest(f"hard links unavailable: {exc}")
+            with self.assertRaisesRegex(ValueError, "different from both inputs"):
+                write_overlay(gc, wii, alias)
+
+    def test_names_only(self):
+        base = local_file()
+        gc = local_file({(11, 7, 0): b"New actor", (13, 4, 0): b"New costume",
+                         (14, 29, 0): b"New stage", (14, 29, 1): b"GC-only description"}, b"G")
+        out, report = build_overlay(base, gc)
+        changed = [(11, 7), (13, 4), (14, 29)]
+        self.assertEqual(report["changed"], ["actor[7]", "costume[4]", "stage[29]"])
+        for slot, index in changed:
+            self.assertEqual(value(out, slot, index), value(gc, slot, index))
+        self.assertEqual(value(out, 14, 29, 1), value(base, 14, 29, 1))
+        # Compare every original metadata byte except the three changed offset words.
+        original_data_length = word(base, 4)
+        restored = bytearray(out[24:24 + original_data_length])
+        for slot, index in changed:
+            pos = cell(base, slot, index)
+            self.assertGreaterEqual(word(out, pos), original_data_length)
+            restored[pos - 24:pos - 20] = base[pos:pos + 4]
+        self.assertEqual(restored, base[24:24 + original_data_length])
+        self.assertEqual(out[24 + word(out, 8):], base[24 + word(base, 8):])
+        self.assertEqual(word(out, 8) % 4, 0)
+        self.assertEqual(word(out, 16) - word(out, 8), word(base, 16) - word(base, 8))
+        self.assertEqual(out, build_overlay(base, gc)[0])
+
+    def test_empty_unsupported_and_length(self):
+        base = local_file()
+        gc = local_file({(11, 0, 0): b"", (11, 1, 0): b"bad\n", (11, 2, 0): b"\\C88888888",
+                         (11, 3, 0): b"prixe\x81", (11, 4, 0): b"$", (11, 5, 0): b"a" * 128,
+                         (11, 6, 0): b"a" * 127, (13, 8, 0): b"M\xe9lodie",
+                         (14, 0, 0): b"x" * 21, (14, 1, 0): b"x" * 20})
+        out, report = build_overlay(base, gc)
+        self.assertEqual(report["changed"], ["actor[6]", "stage[1]"])
+        self.assertEqual(report["kept for empty donor"], ["actor[0]"])
+        self.assertEqual(report["kept for length"], ["actor[5]", "stage[0]"])
+        self.assertEqual(len(report["kept for unsupported characters"]), 5)
+        for i in range(6):
+            self.assertEqual(value(out, 11, i), value(base, 11, i))
+        folded, report = build_overlay(base, gc, fold=True)
+        self.assertEqual(report["folded"], ["costume[8]"])
+        self.assertEqual(value(folded, 13, 8), b"Melodie")
+        self.assertEqual(len(report["kept for unsupported characters"]), 4)
+
+    def test_unchanged_donor_preserves_whole_file(self):
+        base = local_file({(11, 1, 0): b"\x83\x41"})
+        self.assertEqual(build_overlay(base, base)[0], base)
+
+    def test_invalid_donor(self):
+        base = local_file()
+        invalid = []
+        for pos, replacement in [(4, 0xfffffff0), (12, 0xfffffff0), (16, 3),
+                                 (24 + 11 * 4, len(base)), (24 + 14 * 4, 0),
+                                 (cell(base, 11, 0), word(base, cell(base, 11, 0)) + 4),
+                                 (cell(base, 14, 1, 1), word(base, cell(base, 14, 0, 1)))]:
+            copy = bytearray(base)
+            struct.pack_into("<I", copy, pos, replacement)
+            invalid.append(copy)
+        copy = bytearray(base)
+        copy[24 + word(base, 24 + 12 * 4) - 1] = 0x41  # final actor terminator
+        invalid.extend((copy, base[:23], base[:-12], base + bytes(4)))
+        for i, corrupt in enumerate(invalid):
+            with self.subTest(case=i), self.assertRaises(ValueError):
+                build_overlay(base, corrupt)
+
+
+if __name__ == "__main__":
+    unittest.main()
