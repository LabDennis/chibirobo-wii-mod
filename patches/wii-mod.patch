+        jp_l1 = b"\x33" * 32768
+        us_r0 = b"\x44" * 8192
+        us_l0 = b"\x55" * 8192
+        us_r1 = b"\x66" * 8192
+        us_l1 = b"\x77" * 32768
+
+        def make_book_dat(l0_img: bytes, r0_img: bytes, l1_img: bytes, r1_img: bytes) -> bytes:
+            # Layout in data section:
+            # 0x000..0x060: 4 HSD_ImageDesc (L0, R0, L1, R1)
+            # 0x060..0x1D0: 4 HSD_TObjDesc (L0, R0, L1, R1 -> 4 * 0x5C = 0x170)
+            # 0x1D0..0x210: 3 HSD_MObjDesc (3 * 0x10)
+            # 0x210..0x250: 3 HSD_DObjDesc (3 * 0x10)
+            # 0x250..0x2A0: 3 HSD_JObjDesc (J_L0, J_R, J_L1)
+            # 0x2A0..0x2B0: ModelSet + ModelsPtr + SceneData
+            # 0x2B0..0x2E0: 2 TexAnims (2 frames each: [L1, L1] and [R1, R1])
+            # 0x2F0..: pixel blobs
+            img_base = 0x320
+            desc_base = 0x10
+            blobs = [l0_img, r0_img, l1_img, r1_img]
+            data_sz = img_base + sum(len(x) for x in blobs)
+            buf = bytearray(0x20 + data_sz)
+            relocs: list[int] = []
+            cur_p = img_base
+            for i, (bw, bh, blob) in enumerate([(128, 128, l0_img), (128, 128, r0_img), (256, 256, l1_img), (128, 128, r1_img)]):
+                doff = desc_base + i * 0x18
+                struct.pack_into(">IHHIIff", buf, 0x20 + doff, cur_p, bw, bh, fmt, 0, 0.0, 0.0)
+                relocs.append(doff)
+                buf[0x20 + cur_p : 0x20 + cur_p + len(blob)] = blob
+                cur_p += len(blob)
+
+            # TObjDescs: 0=L0, 1=R0, 2=L1, 3=R1
+            for i in range(4):
+                toff = 0x80 + i * 0x5C
+                nxt_t = (0x80 + 3 * 0x5C) if i == 1 else 0  # R0 chains to R1 on same JObj!
+                struct.pack_into(">II", buf, 0x20 + toff, 0, nxt_t)
+                struct.pack_into(">I", buf, 0x20 + toff + 0x4C, desc_base + i * 0x18)
+                relocs.append(toff + 0x4C)
+                if nxt_t:
+                    relocs.append(toff + 4)
+
+            # MObjDescs for L0(0), R0+R1(1), L1(2)
+            for i, toff in [(0, 0x80), (1, 0x80 + 0x5C), (2, 0x80 + 2 * 0x5C)]:
+                moff = 0x1F0 + i * 0x10
+                struct.pack_into(">I", buf, 0x20 + moff + 0x08, toff)
+                relocs.append(moff + 0x08)
+                doff = 0x230 + i * 0x10
+                struct.pack_into(">I", buf, 0x20 + doff + 0x08, moff)
+                relocs.append(doff + 0x08)
+
+            # JObj0 (L0) -> next JObj1 (R0+R1) -> next JObj2 (L1)
+            j0, j1, j2 = 0x270, 0x288, 0x2A0
+            struct.pack_into(">5I", buf, 0x20 + j0, 0, 0, 0, j1, 0x230)
+            struct.pack_into(">5I", buf, 0x20 + j1, 0, 0, 0, j2, 0x240)
+            struct.pack_into(">5I", buf, 0x20 + j2, 0, 0, 0, 0, 0x250)
+            # SceneData @ 0x2C8 -> models_ptr @ 0x2C4 -> model_set @ 0x2C0 -> j0
+            struct.pack_into(">I", buf, 0x20 + 0x2C0, j0)
+            struct.pack_into(">I", buf, 0x20 + 0x2C4, 0x2C0)
+            struct.pack_into(">I", buf, 0x20 + 0x2C8, 0x2C4)
+
+            # TexAnims: imagetbl at 0x2D0 (L1, L1) & 0x2D8 (R1, R1); structs at 0x2E0 & 0x2F8
+            struct.pack_into(">II", buf, 0x20 + 0x2D0, desc_base + 2 * 0x18, desc_base + 2 * 0x18)
+            struct.pack_into(">II", buf, 0x20 + 0x2D8, desc_base + 3 * 0x18, desc_base + 3 * 0x18)
+            struct.pack_into(">II", buf, 0x20 + 0x2EC, 0x2D0, 0)
+            struct.pack_into(">HH", buf, 0x20 + 0x2EC + 8, 2, 0)
+            struct.pack_into(">II", buf, 0x20 + 0x304, 0x2D8, 0)
+            struct.pack_into(">HH", buf, 0x20 + 0x304 + 8, 2, 0)
+            relocs.extend([0x2D0, 0x2D8, 0x2EC, 0x304])
+
+            reloc_bytes = struct.pack(f">{len(relocs)}I", *relocs)
+            root_bytes = struct.pack(">II", 0x2C8, 0) + b"scene_data\x00"
+            hdr = struct.pack(">5I", 0x20 + data_sz + len(reloc_bytes) + len(root_bytes), data_sz, len(relocs), 1, 0) + (b"\x00" * 12)
+            return hdr + bytes(buf[0x20:]) + reloc_bytes + root_bytes
+
+        # Build minimal BRRES with page_L.0 (128x128), page_L.1 (256x256), page_R.0 (128x128), page_R.1 (128x128)
+        entries = [
+            ("page_L.0", 128, 128, jp_blank),
+            ("page_L.1", 256, 256, jp_l1),
+            ("page_R.0", 128, 128, jp_blank),
+            ("page_R.1", 128, 128, jp_r1),
+        ]
+        # Simple BRRES layout: root @ 0x10, folder_grp @ 0x18 (40B), tex_grp @ 0x40 (8 + 5*16 = 88B), names @ 0xA0, TEX0s @ 0x100
+        br = bytearray(0x100)
+        br[0:4] = b"bres"
+        struct.pack_into(">H", br, 12, 0x10)
+        br[0x10:0x14] = b"root"
+        struct.pack_into(">II", br, 0x18, 0, 1)
+        struct.pack_into(">HHHHII", br, 0x18 + 0x18, 0, 0, 0, 0, 0xA0 - 0x18, 0x40 - 0x18)
+        br[0xA0 : 0xA0 + 15] = b"Textures(NW4R)\x00"
+        struct.pack_into(">II", br, 0x40, 0, len(entries))
+        name_cur = 0xB0
+        tex_cur = 0x100
+        for idx, (nm, ew, eh, blob) in enumerate(entries):
+            nb = nm.encode("ascii") + b"\x00"
+            br[name_cur : name_cur + len(nb)] = nb
+            struct.pack_into(">HHHHII", br, 0x40 + 8 + (idx + 1) * 16, 0, 0, 0, 0, name_cur - 0x40, tex_cur - 0x40)
+            name_cur += len(nb)
+            tex0 = bytearray(0x40 + len(blob))
+            tex0[0:4] = b"TEX0"
+            struct.pack_into(">IIiIiIHHII", tex0, 4, len(tex0), 1, 0, 0x40, 0, 0, ew, eh, fmt, 1)
+            tex0[0x40:] = blob
+            br.extend(tex0)
+            tex_cur += len(tex0)
+
+        jp_dat = make_book_dat(jp_blank, jp_blank, jp_l1, jp_r1)
+        tgt_dat = make_book_dat(us_l0, us_r0, us_l1, us_r1)
+        new_br, info = replace_brres_textures(bytes(br), jp_dat, tgt_dat, structural_book=True)
+        parsed = {t["name"]: bytes(t["data"]) for t in parse_brres_textures(new_br)}
+        self.assertEqual(parsed["page_L.0"], us_l0)
+        self.assertEqual(parsed["page_R.0"], us_r0)
+        self.assertIn("page_L.0", info["replaced"])
+        self.assertIn("page_R.0", info["replaced"])
+
+    def test_press_a_pages_replace_textures_0_and_1_only(self) -> None:
+        # a font with one glyph: 'A' is a solid 8x24 block
+        metrics = [(0, 0, 0)] * 256
+        metrics[0x41] = (0, 0, 8)
+        atlas = bytearray(512 * 512 * 4)
+        for y in range(24):
+            for x in range(8):
+                atlas[(y * 512 + x) * 4 : (y * 512 + x) * 4 + 4] = b"\xff\xff\xff\xff"
+
+        def tex(w: int, h: int, fmt: int, rgba: bytes) -> dict:
+            return {"width": w, "height": h, "fmt": fmt, "wrap_s": 0, "wrap_t": 0, "min_filter": 1, "mag_filter": 1,
+                    "lod_bias": 0.0, "edge_lod": 0, "min_lod": 0, "max_lod": 0, "unpacked": 0,
+                    "data": _encode_tpl_pixels(rgba, w, h, fmt), "pal_fmt": None, "pal_data": None}
+
+        white = bytes([255, 255, 255, 255])
+        logo = _build_tpl([tex(640, 480, 4, white * (640 * 480)), tex(640, 480, 4, white * (640 * 480)), tex(16, 16, 4, white * 256)])
+        # misc.tpl needs the stripes the pages take, texture 119: its left half lit
+        half = (white * 8 + bytes(4) * 8) * 16
+        misc = _build_tpl([tex(16, 16, 0, half) if i == 119 else tex(8, 8, 2, white * 64) for i in range(120)])
+
+        out = parse_tpl_textures(press_a_tpl(logo, misc, ["AAA", "A"], metrics, bytes(atlas)))
+        before = parse_tpl_textures(logo)
+        self.assertEqual(out[2]["data"], before[2]["data"])
+        pages = [bytes(_decode_tpl_pixels(bytes(t["data"]), 640, 480, 4)) for t in out[:2]]
+        for page in pages:
+            pixels = {page[i : i + 4] for i in range(0, len(page), 4)}
+            self.assertIn(white, pixels)  # the text
+            self.assertIn(b"\x00\x00\x00\xff", pixels)  # between the stripes
+        self.assertNotEqual(pages[0], pages[1])  # the stripes have moved on
+
+    def test_title_tpl_aspect_fit_replaces_only_logo_and_preserves_aspect(self) -> None:
+        from tools.wii_lang_data import (
+            TITLE_TPL_TEXT_DECISIONS,
+            _decode_tpl_pixels,
+            _fit_rgba_aspect,
+            convert_tpl_textures_by_jp,
+        )
+
+        def tex(w: int, h: int, fmt: int, rgba: bytes) -> dict:
+            return {
+                "width": w, "height": h, "fmt": fmt, "wrap_s": 0, "wrap_t": 0,
+                "min_filter": 1, "mag_filter": 1, "lod_bias": 0.0, "edge_lod": 0,
+                "min_lod": 0, "max_lod": 0, "unpacked": 0,
+                "data": _encode_tpl_pixels(rgba, w, h, fmt), "pal_fmt": None, "pal_data": None,
+            }
+
+        red = bytes([255, 0, 0, 255])
+        blue = bytes([0, 128, 255, 255])
+        white = bytes([255, 255, 255, 255])
+        green = bytes([0, 255, 0, 255])
+
+        wii_b = _build_tpl([
+            tex(40, 20, 5, red * (40 * 20)),
+            tex(20, 8, 2, white * (20 * 8)),
+            tex(8, 8, 5, green * (8 * 8)),
+        ])
+        jp_b = _build_tpl([
+            tex(16, 8, 2, white * (16 * 8)),
+            tex(40, 20, 5, red * (40 * 20)),
+            tex(8, 8, 5, green * (8 * 8)),
+        ])
+        tgt_b = _build_tpl([
+            tex(40, 40, 5, blue * (40 * 40)),
+            tex(24, 8, 2, white * (24 * 8)),
+            tex(8, 8, 5, green * (8 * 8)),
+        ])
+
+        out_b, info = convert_tpl_textures_by_jp(
+            wii_b,
+            jp_b,
+            tgt_b,
+            text_wii_indices=TITLE_TPL_TEXT_DECISIONS,
+            explicit_target_map={0: 0},
+            allow_aspect_fit=True,
+        )
+        self.assertEqual(info["reencoded_indices"], [0])
+        self.assertEqual(info["replaced_indices"], [])
+        wii_texs = parse_tpl_textures(wii_b)
+        out_texs = parse_tpl_textures(out_b)
+        self.assertEqual((out_texs[0]["width"], out_texs[0]["height"], out_texs[0]["fmt"]), (40, 20, 5))
+        self.assertEqual(out_texs[1]["data"], wii_texs[1]["data"])
+        self.assertEqual(out_texs[2]["data"], wii_texs[2]["data"])
+
+        decoded = bytes(_decode_tpl_pixels(bytes(out_texs[0]["data"]), 40, 20, 5))
+        # 40x40 scaled to 40x20 preserving aspect -> 20x20 centered at x=10..29; x=0..9 and 30..39 are transparent
+        self.assertEqual(decoded[(10 * 40 + 2) * 4 + 3], 0)
+        self.assertEqual(decoded[(10 * 40 + 37) * 4 + 3], 0)
+        self.assertGreater(decoded[(10 * 40 + 20) * 4 + 3], 200)
+
+        fitted = _fit_rgba_aspect(blue * (400 * 188), 400, 188, 416, 135)
+        self.assertEqual(len(fitted), 416 * 135 * 4)
+        self.assertEqual(fitted[(67 * 416 + 0) * 4 + 3], 0)
+        self.assertEqual(fitted[(67 * 416 + 208) * 4 + 3], 255)
+
+
+if __name__ == "__main__":
+    unittest.main()
