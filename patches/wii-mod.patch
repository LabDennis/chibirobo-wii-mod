+    def test_brres_tex0_replace_reencode_and_mipmaps(self) -> None:
+        # Build minimal synthetic BRRES with 2 TEX0 entries (tex_a: CMPR 8x8 mip=1, tex_b: I8 8x8 mip=2)
+        def make_solid_rgba(w: int, h: int, rgba_px: bytes) -> bytes:
+            return rgba_px * (w * h)
+
+        def build_res_dic(off_base: int, items: list[tuple[str, int]]) -> tuple[bytes, bytes]:
+            # ResDic header (8B) + (N+1)*16B entries, followed by null-terminated names
+            n = len(items)
+            dic_size = 8 + (n + 1) * 16
+            dic = bytearray(dic_size)
+            names = bytearray()
+            struct.pack_into(">II", dic, 0, dic_size, n)
+            struct.pack_into(">HHHHII", dic, 8, 0xFFFF, 0, 0, 0, 0, 0)
+            for idx, (name, abs_target) in enumerate(items, start=1):
+                name_off = dic_size + len(names)
+                names.extend(name.encode("ascii") + b"\x00")
+                struct.pack_into(">HHHHII", dic, 8 + idx * 16, 0, 0, 0, 0, name_off, abs_target - off_base)
+            return bytes(dic), bytes(names)
+
+        # Layout: bres(16) + root_hdr(8) + root_dic(40) + folder_dic(56) + names + tex0_a + tex0_b
+        tex_a_data = _encode_tpl_pixels(make_solid_rgba(8, 8, b"\x00\xff\x00\xff"), 8, 8, 14)
+        tex_b_m0 = _encode_tpl_pixels(make_solid_rgba(8, 8, b"\x40\x40\x40\xff"), 8, 8, 1)
+        tex_b_m1 = _encode_tpl_pixels(make_solid_rgba(4, 4, b"\x40\x40\x40\xff"), 4, 4, 1)
+        tex_b_data = tex_b_m0 + tex_b_m1
+
+        root_off = 16
+        root_dic_off = root_off + 8
+        folder_dic_off = root_dic_off + 40 + 16  # 1 entry + name "Textures(NW4R)\0" (15B -> 16B)
+        tex0_a_off = folder_dic_off + 56 + 16    # 2 entries + names "tex_a\0tex_b\0" (12B -> 16B)
+        tex0_a_hdr_size = 64
+        tex0_b_off = tex0_a_off + tex0_a_hdr_size + len(tex_a_data)
+        tex0_b_hdr_size = 64
+        total_size = tex0_b_off + tex0_b_hdr_size + len(tex_b_data)
+
+        out = bytearray(total_size)
+        struct.pack_into(">4sHHIHH", out, 0, b"bres", 0xFEFF, 0, total_size, 16, 2)
+        struct.pack_into(">4sI", out, root_off, b"root", folder_dic_off - root_off)
+        rd, rn = build_res_dic(root_dic_off, [("Textures(NW4R)", folder_dic_off)])
+        out[root_dic_off : root_dic_off + len(rd)] = rd
+        out[root_dic_off + len(rd) : root_dic_off + len(rd) + len(rn)] = rn
+
+        fd, fn = build_res_dic(folder_dic_off, [("tex_a", tex0_a_off), ("tex_b", tex0_b_off)])
+        out[folder_dic_off : folder_dic_off + len(fd)] = fd
+        out[folder_dic_off + len(fd) : folder_dic_off + len(fd) + len(fn)] = fn
+
+        def write_tex0(off: int, w: int, h: int, fmt: int, mips: int, data: bytes) -> None:
+            struct.pack_into(">4sIIiIiIHHII", out, off, b"TEX0", 64 + len(data), 1, -off, 64, 0, 0, w, h, fmt, mips)
+            out[off + 64 : off + 64 + len(data)] = data
+
+        write_tex0(tex0_a_off, 8, 8, 14, 1, tex_a_data)
+        write_tex0(tex0_b_off, 8, 8, 1, 2, tex_b_data)
+        wii_brres = bytes(out)
+
+        def build_dat(imgs: list[tuple[int, int, int, bytes]]) -> bytes:
+            data = bytearray()
+            relocs = []
+            descs_off = 0
+            data.extend(b"\x00" * (len(imgs) * 0x18))
+            for idx, (w, h, fmt, px_data) in enumerate(imgs):
+                ptr = len(data)
+                data.extend(px_data)
+                d_off = descs_off + idx * 0x18
+                struct.pack_into(">IHHIIff", data, d_off, ptr, w, h, fmt, 0, 0.0, 0.0)
+                relocs.append(d_off)
+            hdr = struct.pack(">5I12x", 0x20 + len(data) + len(relocs) * 4, len(data), len(relocs), 0, 0)
+            return hdr + bytes(data) + struct.pack(f">{len(relocs)}I", *relocs)
+
+        # In GC-JP: tex_a is CMPR green, tex_b is CMPR grey (0x40)
+        jp_b_cmpr = _encode_tpl_pixels(make_solid_rgba(8, 8, b"\x40\x40\x40\xff"), 8, 8, 14)
+        jp_dat = build_dat([(8, 8, 14, tex_a_data), (8, 8, 14, jp_b_cmpr)])
+        # In GC-target: tex_a unchanged, tex_b changed to bright white (0xFF) in CMPR
+        tgt_b_cmpr = _encode_tpl_pixels(make_solid_rgba(8, 8, b"\xff\xff\xff\xff"), 8, 8, 14)
+        tgt_dat = build_dat([(8, 8, 14, tex_a_data), (8, 8, 14, tgt_b_cmpr)])
+
+        new_brres, stats = replace_brres_textures(wii_brres, jp_dat, tgt_dat)
+        self.assertEqual(len(new_brres), len(wii_brres))
+        self.assertEqual(stats["unchanged"], ["tex_a"])
+        self.assertEqual(stats["reencoded"], ["tex_b"])
+        self.assertEqual(stats["skipped"], [])
+
+        parsed = {t["name"]: t for t in parse_brres_textures(new_brres)}
+        self.assertEqual(parsed["tex_a"]["data"], tex_a_data)
+        # Level 0 (8x8 I8) and Level 1 (4x4 I8) should both be ~0xFF luminance
+        new_b_m0 = _decode_tpl_pixels(bytes(parsed["tex_b"]["data"])[:64], 8, 8, 1)
+        new_b_m1 = _decode_tpl_pixels(bytes(parsed["tex_b"]["data"])[64:], 4, 4, 1)
+        self.assertGreater(new_b_m0[0], 240)
+        self.assertGreater(new_b_m1[0], 240)
+
