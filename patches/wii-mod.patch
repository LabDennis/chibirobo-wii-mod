+        report["languages"][code] = {
+            "transferred_files": transferred_files,
+            "identical_files": identical_files,
+            "non_transferable_files": non_transferable_files,
+            "wii_only_files": wii_only_files,
+            "total_messages": total_msgs,
+            "translated_messages": translated_msgs,
+            "untranslated_messages": untranslated_msgs,
+            "bin_details": per_bin_details,
+            "tpl_details": tpl_details,
+            "brres_details": brres_details,
+        }
+
+    # Japanese keeps the disc's own files, but for the first screen
+    ja_out = out_dir / "lang" / "ja"
+    if ja_out.exists():
+        shutil.rmtree(ja_out)
+    (ja_out / "tpl").mkdir(parents=True)
+    if press_a is not None and dol_font is not None:
+        for name in ("logo.tpl", "logow.tpl"):
+            dst = ja_out / "tpl" / name
+            dst.write_bytes(
+                press_a_tpl((extracted["wii_tpl"] / name).read_bytes(), misc_tpl.read_bytes(), press_a["ja"], dol_font[0], dol_font[1],
+                            preview_dir=preview_dir, preview_prefix=f"ja_{name[:-4]}")
+            )
+            written_files.append(dst)
+
+    report_path = out_dir / "report.json"
+    report_path.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+    if depfile is not None:
+        deps = [d for d in (wii_disc, us_disc, pal_disc, jp_disc) if d is not None]
+        _write_depfile(depfile, [report_path, *written_files], deps)
+    return report
+
+
+def main(argv: Optional[Sequence[str]] = None) -> int:
+    parser = argparse.ArgumentParser(description="Generate Wii multi-language override files from GC discs.")
+    parser.add_argument("--dtk", required=True, type=Path)
+    parser.add_argument("--wii", required=True, type=Path)
+    parser.add_argument("--us", default=None, type=Path, help="GameCube disc of the US release")
+    parser.add_argument("--pal", default=None, type=Path, help="GameCube disc of the European release")
+    parser.add_argument("--jp", default=None, type=Path, help="Optional GC JP disc (auto-detected if sibling GGTJ01_01 exists)")
+    parser.add_argument("--work", required=True, type=Path)
+    parser.add_argument("--out", required=True, type=Path)
+    parser.add_argument("--depfile", default=None, type=Path)
+    args = parser.parse_args(argv)
+
+    jp_disc = args.jp if args.jp is not None else _auto_detect_jp_disc(args.wii)
+    try:
+        build_language_data(
+            dtk=args.dtk,
+            wii_disc=args.wii,
+            us_disc=args.us,
+            pal_disc=args.pal,
+            work_dir=args.work,
+            out_dir=args.out,
+            jp_disc=jp_disc,
+            depfile=args.depfile,
+        )
+    except Exception as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
