@@ -0,0 +1,35 @@
+"""Synchronize the generated language subtree into one mod's files directory."""
+import os
+import shutil
+import sys
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+
+def install(files, target, codes=("en", "de", "fr", "es", "it")):
+    """Install the generated languages `codes` as `target` (a mod's files/lang)."""
+    source = files / "lang"
+    for code in codes:
+        if not (source / code).is_dir():
+            raise ValueError(f"Missing generated language directory: {source / code}")
+    # Only the generated lang subtree belongs to this rule. Keep sibling mod files.
+    target.parent.mkdir(parents=True, exist_ok=True)
+    with TemporaryDirectory(dir=target.parent) as tmp:
+        staged = Path(tmp) / "lang"
+        staged.mkdir()
+        for code in codes:
+            shutil.copytree(source / code, staged / code)
+        old = Path(tmp) / "old"
+        if target.exists():
+            target.rename(old)
+        try:
+            staged.rename(target)
+        except OSError:
+            if old.exists():
+                old.rename(target)
+            raise
+    os.utime(target)
+
+
+if __name__ == "__main__":
+    install(Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3:] or ("en", "de", "fr", "es", "it"))
diff --git a/tools/wii_locale.py b/tools/wii_locale.py
new file mode 100644
index 00000000..529f2d3c
--- /dev/null
+++ b/tools/wii_locale.py
@@ -0,0 +1,184 @@
+"""Generate Wii interface strings. The NAND banner uses two 32-unit UTF-16 fields."""
+
+import hashlib
+import json
+import subprocess
+import tempfile
+import os
+from pathlib import Path
+
+from .versions import DISC_EXT
+
+
+def disc_image(folder: Path) -> Path:
+    # DTK can split a disc image directly, so a successful build need not leave an extracted partition.
+    images = sorted(p for p in folder.glob("*") if p.is_file() and p.suffix.lower() in DISC_EXT)
+    if images:
+        return images[0]
+    extracted = folder / "sys/main.dol"
+    if extracted.is_file() and (folder / "sys/boot.bin").is_file() and (folder / "files").is_dir():
+        return extracted
+    raise ValueError(f"Place the disc image or its extracted game partition in {folder}")
+
+
+def write_header(translations: Path, locale: str, output: Path) -> None:
+    locales = json.loads(translations.read_text(encoding="utf-8"))
+    selected = SYSTEM_LOCALES if locale == "global" else (locale,)
+    lines = []
+    for number, name in enumerate(selected):
+        lines.extend(interface_row(name, locales[name], number))
+    rows = [f"sInterfaceRow{i}" for i in range(len(selected))]
+    if locale != "global":
+        rows *= len(SYSTEM_LOCALES)
+    lines.append("static const char* const* const sWiiInterfaceRows[] = { " + ", ".join(rows) + " };")
+    text = "\n".join(lines) + "\n"
+    output.parent.mkdir(parents=True, exist_ok=True)
+    if not output.exists() or output.read_text(encoding="ascii") != text:
+        output.write_text(text, encoding="ascii")
+
+
+SYSTEM_LOCALES = ("en-US", "de-DE", "fr-FR", "es-ES", "it-IT")
+
+
+def interface_row(locale, strings, number):
+    if len(strings) != 6 or any(not isinstance(s, str) or not s or "\0" in s for s in strings):
+        raise ValueError(f"{locale}: expected the six Wii title, banner and controller messages")
+    lines = []
+    entries = []
+    for index, string in enumerate(strings):
+        if index in (1, 2):
+            data = string.encode("utf-16-be")
+            if len(data) > 62:
+                raise ValueError(f"{locale}: NAND banner line {index} exceeds 31 UTF-16 units")
+            units = [f"0x{int.from_bytes(data[i:i+2], 'big'):04x}" for i in range(0, len(data), 2)]
+            lines.append(f"static const u16 sBannerLine{number}_{index}[] = {{ {', '.join([*units, '0'])} }};")
+            entries.append(f"reinterpret_cast<const char*>(sBannerLine{number}_{index})")
+        else:
+            # The retail Japanese renderer reads Shift-JIS. Keep starter prompts in its ASCII range.
+            if not string.isascii() or any(ord(c) < 32 or ord(c) > 126 for c in string):
+                raise ValueError(f"{locale}: Wii message {index} requires printable ASCII")
+            entries.append(json.dumps(string))
+    lines += [f"static const char* const sInterfaceRow{number}[] = {{", *(f"    {s}," for s in entries), "};"]
+    return lines
+
+
+def opening_banner(data, titles):
+    if len(data) < 0x600 or data[0x40:0x48] != b"IMET\0\0\x06\0":
+        raise ValueError("opening.bnr has an invalid IMET header")
+    banner = bytearray(data)
+    for number, title in titles.items():
+        encoded = title.encode("utf-16-be")
+        if len(encoded) > 82 or "\0" in title:
+            raise ValueError("opening.bnr title exceeds its field or contains NUL")
+        start = 0x5c + 84 * number
+        banner[start:start + 84] = encoded.ljust(84, b"\0")
+    banner[0x5f0:0x600] = bytes(16)
+    banner[0x5f0:0x600] = hashlib.md5(banner[:0x600]).digest()
+    return banner
+
+
+def write_opening_banner(disc, dtk, translations, locale, out):
+    strings = json.loads(translations.read_text(encoding="utf-8"))
+    titles = {i: strings[name if locale == "global" else locale][0]
+              for i, name in enumerate(SYSTEM_LOCALES, 1)}
+    for i in range(6, 10):
+        titles[i] = titles[1]
+    if locale != "global":
+        titles[0] = titles[1]
+    with tempfile.TemporaryDirectory(dir=out.parent) as tmp:
+        original = disc.parent.parent / "files/opening.bnr"
+        if disc.name != "main.dol":
+            original = Path(tmp) / "retail.bnr"
+            subprocess.run([str(dtk), "vfs", "cp", "-q", f"{disc}:files/opening.bnr", str(original)], check=True)
+        generated = Path(tmp) / "opening.bnr"
+        generated.write_bytes(opening_banner(original.read_bytes(), titles))
+        generated.replace(out)
+
+
+LANGUAGES = ("en", "de", "fr", "es", "it")
+
+
+def write_text_tables(folder: Path, output: Path) -> None:
+    """Write the Wii slot -> US slot maps and the texts of our own: a record without "override" fills Wii-only
+    slots (no US text) in every language; an "override" record replaces the mapped US text in the languages it
+    lists, where the US lines do not fit the lines the Wii prints."""
+    mapping = json.loads((folder / "text_map.json").read_text())
+    records = json.loads((folder / "wii_text.json").read_text(encoding="utf-8"))
+    interface = mapping["interface"][:301]
+    lines = []
+    for name, entries in (("Interface", interface), ("PC", mapping["pc"])):
+        values = ", ".join(str(i if i is not None else -1) for i in entries)
+        lines.append(f"static const s16 s{name}Map[] = {{ {values} }};")
+    lines.append("static const char* WiiOnlyText(u8 language, s32 index) {")
+    lines.append("    switch (index) {")
+    seen = set()
+    for record in records:
+        override = record.get("override", False)
+        for index in record["indices"]:
+            if index in seen or not 6 <= index < 301 or (interface[index] is not None) != override:
+                raise ValueError(f"unexpected {'override' if override else 'Wii-only'} index {index}")
+            seen.add(index)
+            lines.append(f"    case {index}:")
+        strings = []
+        for lang in LANGUAGES:
+            value = record["translations"].get(lang)
+            if value is None and override:
+                strings.append("0")
+                continue
+            if value is None or (not value and not override) or any(ord(c) < 32 for c in value):
+                raise ValueError(f"invalid text for {lang} at {record['indices']}")
+            strings.append('"' + ''.join(f'\\{c:03o}' for c in value.encode("cp1252")) + '"')
+        lines.append("        { static const char* const text[] = { " + ", ".join(strings)
+                     + " }; return text[language - 1]; }")
+    lines.extend(["    }", "    return 0;", "}"])
+    text = "\n".join(lines) + "\n"
+    if not output.exists() or output.read_text() != text:
+        output.write_text(text, encoding="ascii")
+
+
+def write_localization(translations: Path, locale: str, output: Path) -> None:
+    write_header(translations, locale, output / "include/wii_locale.h")
+    write_text_tables(translations.parent, output / "include/wii_text.h")
+
+
+def write_mod(output: Path, base: Path, features: str) -> None:
+    # Dolphin mounts patched files over the original partition and retains its disc identity.
+    (output / "files").mkdir(parents=True, exist_ok=True)
+    xml = """<wiidisc version="1" root="/">
+  <id game="R24J" developer="01" disc="0" version="0" />
+  <options><section name="Chibi-Robo!"><option name="Mod" id="mod" default="1">
+    <choice name="FEATURES"><patch id="mod" /></choice>
+  </option></section></options>
+  <patch id="mod">
+    <file disc="main.dol" external="/main.dol" />
+    <folder disc="/" external="/files" recursive="true" create="true" />
+  </patch>
+</wiidisc>
+"""
+    (output / "riivolution.xml").write_text(xml.replace("FEATURES", features), encoding="utf-8")
+    base = base.resolve()
+    try:
+        relative_base = Path(os.path.relpath(base, output))
+    except ValueError:  # Windows paths on different drives
+        relative_base = base
+    descriptor = {
+        "type": "dolphin-game-mod-descriptor", "version": 1,
+        "display-name": f"Chibi-Robo! (Wii, {features})",
+        "base-file": relative_base.as_posix(),
+        "riivolution": {"patches": [{"xml": "riivolution.xml", "root": ".",
+                        "options": [{"option-id": "mod", "choice": 1}]}]},
+    }
+    (output / "game.json").write_text(json.dumps(descriptor, indent=2) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    import argparse
+
+    parser = argparse.ArgumentParser()
+    parser.add_argument("disc", type=Path)
+    parser.add_argument("dtk", type=Path)
+    parser.add_argument("translations", type=Path)
+    parser.add_argument("locale")
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    write_opening_banner(args.disc, args.dtk, args.translations, args.locale, args.output)
diff --git a/tools/wii_stage_names.py b/tools/wii_stage_names.py
new file mode 100644
index 00000000..192fef49
--- /dev/null
+++ b/tools/wii_stage_names.py
@@ -0,0 +1,174 @@
+"""Build a private Wii globals.bin overlay from an extracted GameCube globals.bin."""
+
+import argparse
+import hashlib
+import os
+import struct
+import tempfile
+import unicodedata
+from collections import defaultdict
+from pathlib import Path
+
+
+HEADER = struct.Struct("<6I")
+DIRECTORY = struct.Struct("<21I")
+WORD = struct.Struct("<I")
+R24J01_GLOBALS_SHA256 = "9b868ead42ba15d502f34d03f946e5c726fd3d782f22ff6c3087e702746e510d"
+# Directory byte offset, row count, number of pointer fields per row.
+TABLES = {"actor": (0x2C, 64, 1), "costume": (0x34, 9, 1), "stage": (0x38, 30, 2)}
+
+
+def metadata(blob):
+    if len(blob) < HEADER.size:
+        raise ValueError("truncated globals.bin header")
+    data, size, collision, collision_size, script, script_size = HEADER.unpack_from(blob)
+    end = len(blob) - HEADER.size
+    if (data != 0 or size < DIRECTORY.size or collision != ((size + 3) & ~3)
+            or script != ((collision + collision_size + 3) & ~3) or not collision_size or not script_size
+            or not 0 <= end - script - script_size <= 3):
+        raise ValueError("invalid globals.bin section offsets or lengths")
+    return blob[HEADER.size:HEADER.size + size]
+
+
+def name_tables(data):
+    """Validate retail row counts and string extents, including stage descriptions."""
+    offsets = DIRECTORY.unpack_from(data)
+    if offsets[0] != DIRECTORY.size or any(p and not DIRECTORY.size <= p < len(data) for p in offsets):
+        raise ValueError("invalid metadata directory")
+    starts = [p for p in offsets if p]
+    if len(set(starts)) != len(starts):
+        raise ValueError("overlapping metadata tables")
+
+    tables = {}
+    for name, (slot, count, fields) in TABLES.items():
+        start = offsets[slot // 4]
+        limit = min((p for p in starts if p > start), default=len(data))
+        stride = fields * WORD.size
+        cursor = start + count * stride
+        if not start or cursor > limit:
+            raise ValueError(f"invalid {name} table size")
+        rows = []
+        # Retail puts every name directly after the records, then every description.
+        for field in range(fields):
+            for index in range(count):
+                pos = start + index * stride + field * WORD.size
+                if WORD.unpack_from(data, pos)[0] != cursor:
+                    raise ValueError(f"{name} {index}: unexpected field {field} string offset")
+                end = data.find(b"\0", cursor, limit)
+                if end < 0:
+                    raise ValueError(f"{name} {index}: unterminated field {field}")
+                if field == 0:
+                    rows.append((pos, data[cursor:end]))
+                cursor = end + 1
+        if cursor != limit:
+            raise ValueError(f"{name} strings do not end at the next metadata table")
+        tables[name] = rows
+    return tables
+
+
+# Letters and punctuation without a useful ASCII canonical decomposition.
+ASCII_EQUIVALENTS = str.maketrans({
+    "ß": "ss", "Æ": "AE", "æ": "ae", "Œ": "OE", "œ": "oe", "Ø": "O", "ø": "o",
+    "‘": "'", "’": "'", "“": '"', "”": '"', "–": "-", "—": "-", "…": "...",
+    "¡": "!", "¿": "?", "\N{NO-BREAK SPACE}": " ",
+})
+
+
+def western_name(raw, fold):
+    try:
+        text = raw.decode("cp1252" if fold else "ascii")
+    except UnicodeDecodeError:
+        return None
+    if fold:
+        text = unicodedata.normalize("NFD", text.translate(ASCII_EQUIVALENTS))
+        text = "".join(c for c in text if not unicodedata.combining(c))
+    # Backslash introduces a graphics escape, and the message formatter rewrites '$'.
+    if any(not " " <= c <= "~" or c in "\\$" for c in text):
+        return None
+    return text.encode("ascii")
+
+
+def build_overlay(wii, gc, fold=False):
+    data = metadata(wii)
+    original = name_tables(data)
+    donor = name_tables(metadata(gc))
+    updated = bytearray(data)
+    report = defaultdict(list)
+    for table in TABLES:
+        for index, ((pos, old), (_, raw)) in enumerate(zip(original[table], donor[table])):
+            key = f"{table}[{index}]"
+            if raw == old:
+                report["unchanged"].append(key)
+                continue
+            if not raw:
+                report["kept for empty donor"].append(key)
+                continue
+            name = western_name(raw, fold)
+            if name is None:
+                report["kept for unsupported characters"].append(key)
+                continue
+            # R24J01 stage titles display 20 glyphs. The message formatter has a
+            # 128-byte string scratch buffer for arguments such as actor names.
+            if len(name) > (20 if table == "stage" else 127):
+                report["kept for length"].append(key)
+                continue
+            if name != raw:
+                report["folded"].append(key)
+            if name == old:
+                report["unchanged"].append(key)
+                continue
+            WORD.pack_into(updated, pos, len(updated))
+            updated.extend(name + b"\0")
+            report["changed"].append(key)
+
+    if len(updated) == len(data):
+        return wii, report
+    _, _, collision, collision_size, script, script_size = HEADER.unpack_from(wii)
+    new_collision = (len(updated) + 3) & ~3
+    new_script = script + new_collision - collision
+    header = HEADER.pack(0, len(updated), new_collision, collision_size, new_script, script_size)
+    padding = bytes(new_collision - len(updated))
+    return header + updated + padding + wii[HEADER.size + collision:], report
+
+
+def write_overlay(gc_file, wii_file, output, fold=False):
+    for source in (gc_file, wii_file):
+        if output.resolve() == source.resolve() or (output.exists() and output.samefile(source)):
+            raise ValueError("choose an output path different from both inputs")
+    wii = wii_file.read_bytes()
+    if hashlib.sha256(wii).hexdigest() != R24J01_GLOBALS_SHA256:
+        raise ValueError("expected the original R24J01 files/bin/globals.bin as Wii input")
+    result, report = build_overlay(wii, gc_file.read_bytes(), fold)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    tmp = None
+    try:
+        with tempfile.NamedTemporaryFile(dir=output.parent, delete=False) as f:
+            tmp = Path(f.name)
+            f.write(result)
+        os.replace(tmp, output)
+    finally:
+        if tmp is not None:
+            tmp.unlink(missing_ok=True)
+    return report
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("gc", type=Path, help="private, extracted GameCube language globals.bin")
+    parser.add_argument("wii", type=Path, help="original R24J01 files/bin/globals.bin")
+    parser.add_argument("output", type=Path, help="overlay file, e.g. build/wii-en-US/files/bin/globals.bin")
+    parser.add_argument("--fold-cp1252", action="store_true",
+                        help="allow lossy conversion of Western accents and punctuation to ASCII")
+    args = parser.parse_args()
+    try:
+        report = write_overlay(args.gc, args.wii, args.output, args.fold_cp1252)
+    except (ValueError, OSError) as exc:
+        parser.exit(1, f"{parser.prog}: {exc}\n")
+    print(f"{args.output}: {len(report['changed'])} of 103 display names changed")
+    for reason in ("kept for empty donor", "kept for unsupported characters", "kept for length", "folded"):
+        if report[reason]:
+            print(f"{reason} ({len(report[reason])}): {', '.join(report[reason])}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/wii_text_map.py b/tools/wii_text_map.py
new file mode 100644
index 00000000..432a1950
--- /dev/null
+++ b/tools/wii_text_map.py
@@ -0,0 +1,122 @@
+"""Print the R24J01 -> GGTE01 text index map for two original DOLs.
+
+The values index the US build's tables, which every non-Japanese language of the Wii DOL shares. The US
+build keeps its Japanese table (gJapaneseInterfaceText) in the same order wherever both languages print the
+same slot, so identical Japanese text gives the slot; the save prompts below are the exception."""
+
+import argparse
+import hashlib
+import json
+import struct
+from collections import defaultdict
+from pathlib import Path
+
+
+class Dol:
+    def __init__(self, path, version):
+        self.data = path.read_bytes()
+        manifest = Path(__file__).resolve().parents[1] / "config" / version / "build.sha1"
+        expected = next(line.split()[0] for line in manifest.read_text().splitlines()
+                        if line.split()[-1] == f"build/{version}/main.dol")
+        if hashlib.sha1(self.data).hexdigest() != expected:
+            raise ValueError(f"{path} is not the original {version} main.dol")
+        self.sections = list(zip(*(struct.unpack_from(">18I", self.data, pos)
+                                   for pos in (0, 72, 144))))
+
+    def offset(self, address):
+        for offset, start, size in self.sections:
+            if start <= address < start + size:
+                return offset + address - start
+        raise ValueError(f"unmapped DOL address {address:#x}")
+
+    def pointers(self, address, count):
+        return struct.unpack_from(f">{count}I", self.data, self.offset(address))
+
+    def strings(self, address, count):
+        result = []
+        for pointer in self.pointers(address, count):
+            offset = self.offset(pointer)
+            result.append(self.data[offset:self.data.index(0, offset)])
+        return result
+
+
+def match_table(wii, gc, skip=0):
+    candidates = defaultdict(list)
+    for index, value in enumerate(gc):
+        candidates[value].append(index)
+    mapped = [None] * len(wii)
+    unclear = []
+    for index in range(skip, len(wii)):
+        hits = candidates[wii[index]]
+        if len(hits) == 1:
+            mapped[index] = hits[0]
+        elif hits:
+            unclear.append(index)
+    return mapped, unclear
+
+
+# GC call sites under src/game at ae152594. For multiline card prompts, the
+# matched heading, surrounding unique entries and line position identify each
+# continuation/padding slot within the same five-slot record.
+# (Wii start, Japanese GC start, number of consecutive slots)
+INTERFACE_DECISIONS = [
+    # stg.cpp:2919-24 adds the menu base. Slots 48..56 are successive
+    # placeholders for mode titles (:856-870) and panel fields (:532-659).
+    (49, 48, 9),
+    (60, 59, 1),  # stg.cpp:1054, contextual action, relative PC label 14.
+    (59, 58, 1),  # stg.cpp:1038, PC menu return action (label 13 + base 45).
+    (65, 64, 2),  # stg.cpp:10585, yes/no for the scrap transaction.
+    (79, 78, 1),  # stg.cpp:10585, second line confirming that transaction.
+    (86, 85, 3),  # gameccameraset.cpp:260, DVD states 4/6 insert, 11 unreadable.
+    (98, 97, 1),  # gxb.cpp:2619, option-panel help now describes menu controls.
+    (102, 101, 2),  # gxb.cpp:2604, load-screen confirmation choices.
+]
+
+
+# The save prompts are five-line records. Japanese and English break the same message into lines at
+# different places, and the US build prints them through its own branch (IsJapanese()), so line n of a
+# Japanese record is not line n of the English one: the record maps as a whole, the Wii prints its lines
+# 0..n from the start of the US record. (Wii start, US start, number of records.) Wii 164-168 is the
+# Wii's own "no free files" record; Wii 254-263 are the two damaged-card records the US build added at
+# 248-257 and the Japanese build lacks.
+SAVE_RECORDS = [(104, 103, 12), (169, 163, 17), (254, 248, 2)]
+# The save banner's title and play time and the yes/no marks: the US build prints them from slots of its
+# own, past the Japanese table (memcardbanner.cpp, DrawOXMenu).
+BANNER_SLOTS = {264: 258, 265: 259, 266: 260, 267: 261}
+
+
+def build_map(wii, gc):
+    interface_base, = wii.pointers(0x802FF2C8, 1)
+    pc_base, = wii.pointers(0x802FF2E4, 1)
+    # The requested 325-word window includes the adjacent 24 PC pointers.
+    count = (pc_base - interface_base) // 4
+    interface, unclear = match_table(wii.strings(interface_base, count),
+                                     gc.strings(0x802167E8, 250), skip=6)
+    interface.extend([None] * (325 - count))
+    for start, target, length in INTERFACE_DECISIONS:
+        for delta in range(length):
+            interface[start + delta] = target + delta
+    for index in range(SAVE_RECORDS[0][0], max(BANNER_SLOTS) + 1):
+        interface[index] = None
+    for start, target, records in SAVE_RECORDS:
+        for line in range(5 * records):
+            interface[start + line] = target + line
+    for index, target in BANNER_SLOTS.items():
+        interface[index] = target
+    pc, pc_unclear = match_table(wii.strings(pc_base, 24), gc.strings(0x80216BD0, 24))
+    # stg.cpp:1139 keeper animation, :222/:1131 rank messages by level,
+    # :1152 state 9 and :1163 default ticker. All pass the index unchanged.
+    for index in [2, *range(4, 15), 16, 19]:
+        pc[index] = index
+    # Flat list of Wii slots: PC index n occupies interface window slot 301+n.
+    return {"interface": interface, "pc": pc, "unclear": sorted(
+        [i for i in unclear if interface[i] is None]
+        + [count + i for i in pc_unclear if pc[i] is None])}
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("wii_dol", type=Path)
+    parser.add_argument("gc_dol", type=Path)
+    args = parser.parse_args()
+    print(json.dumps(build_map(Dol(args.wii_dol, "R24J01"), Dol(args.gc_dol, "GGTE01")), indent=2))
