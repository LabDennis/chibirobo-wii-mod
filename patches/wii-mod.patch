+        brres = bytearray(0x100 + len(tex0_hdr) + 40)
+        brres[0:4] = b"bres"
+        struct.pack_into(">H", brres, 12, 0x10)
+        brres[0x10:0x14] = b"root"
+        # root idx_group @ 0x18: 1 folder ("Textures(NW4R)")
+        struct.pack_into(">II", brres, 0x18, 0, 1)
+        struct.pack_into(">HHHHII", brres, 0x20 + 0x10, 0, 0, 0, 0, 0x40, 0x60)
+        brres[0x58:0x58 + 15] = b"Textures(NW4R)\x00"
